use std::io::{Read, Write, host, read_char, write_char}

struct Input { look: i32, started: bool, ok: bool, bytes: u32 }
fn advance() uses (input: mut Input, reader: mut Read) {
    input.look = read_char()
    if input.look != -1 {
        input.bytes += 1
    }
    if input.bytes > 131072 {
        input.ok = false
        input.look = -1
    }
}
fn whitespace(_ c: i32) -> bool {
    c == 32 || c == 9 || c == 10 || c == 13
}
// Bounded parser: rejects sign, overflow, non-digits, too many fields and >128KiB.
fn number() -> u64 uses (input: mut Input, reader: mut Read) {
    if !input.started {
        advance()
        input.started = true
    }
    while whitespace(input.look) {
        advance()
    }
    if input.look < 48 || input.look > 57 {
        input.ok = false
        return 0
    }
    var n: u64 = 0
    while input.look >= 48 && input.look <= 57 {
        if n > 429496729 || (n == 429496729 && input.look > 53) {
            input.ok = false
            return 0
        }
        let digit: u64 = (input.look - 48).downcast_unchecked()
        n = n * 10 + digit
        advance()
    }
    if input.look != -1 && !whitespace(input.look) {
        input.ok = false
    }
    n
}
fn input_done() -> bool uses (input: mut Input, reader: mut Read) {
    while whitespace(input.look) {
        advance()
    }
    input.ok && input.look == -1
}
fn out(_ n: i64) uses (writer: mut Write) {
    if n < 0 {
        write_char(45)
        out(-n)
    } else {
        if n >= 10 { out(n / 10) }
        let c: i32 = (n % 10 + 48).downcast_unchecked()
        write_char(c)
    }
}
fn field(_ n: i64) uses (writer: mut Write) {
    write_char(32)
    out(n)
}
fn small(_ n: usize) -> i64 {
    n.downcast_unchecked()
}

fn emit_action(_ tag: i64, _ action: Action) uses (writer: mut Write) {
    out(tag)
    field(action.kind)
    field(small(action.from))
    field(small(action.to))
    field(action.amount)
    write_char(10)
}
fn emit_economy(_ s: State, _ side: i64) uses (writer: mut Write) {
    let budget = economy(s, side)
    let player: usize = side.downcast_unchecked()
    out(7)
    field(side)
    field(s.food[player])
    field(budget.gold_income)
    field(budget.food_production)
    field(budget.food_upkeep)
    field(budget.food_production - budget.food_upkeep)
    field(budget.disconnected)
    field(budget.shortage)
    var projected = s
    projected.side = side
    projected = begin_turn(projected)
    field(projected.food[player])
    write_char(10)
}
fn emit_decision(_ decision: Decision, _ trace_index: usize) uses (writer: mut Write) {
    out(9)
    field(small(trace_index))
    field(decision.side)
    field(decision.action.kind)
    field(small(decision.action.from))
    field(small(decision.action.to))
    field(decision.action.amount)
    field(decision.focus.kind)
    field(small(decision.focus.target))
    field(decision.depth)
    field(decision.nodes)
    field(decision.search_score)
    field(decision.before_score)
    field(decision.after_score)
    for i in 0 .. 8 { field(decision.deltas[i]) }
    field(decision.highlight)
    field(decision.order_cost)
    write_char(10)
}
fn run() -> i32 uses (input: mut Input, reader: mut Read, writer: mut Write) {
    let version = number()
    let mode = number()
    let difficulty = number()
    let scenario = number()
    let count = number()
    if !input.ok || version != 7 || scenario > 2 || mode > 3 || difficulty > 1 || count > 2048 { return 2 }
    var trace = [pass(); 2048]
    var length: usize = count.downcast_unchecked()
    var s = initial(scenario.downcast_unchecked())
    for i in 0 .. length {
        let kind = number()
        let from = number()
        let to = number()
        let amount = number()
        if !input.ok || kind > 12 || from > 63 || to > 63 || amount > 12 { return 2 }
        let action = Action {
            kind: kind.downcast_unchecked(), from: from.downcast_unchecked(),
            to: to.downcast_unchecked(), amount: amount.downcast_unchecked(),
        }
        if !is_legal(s, action) { return 2 }
        s = apply(s, action)
        trace[i] = action
    }
    if !input_done() { return 2 }
    var stats = Search { nodes: 0 }
    var decisions = empty_decision_history()
    if mode != 1 {
        while s.result == 0 && !s.decision_pending && (s.side == 2 || mode >= 2) {
            // Capacity is an unfinished transport pause, not a game result.
            if length >= TRACE_CAPACITY { break }
            let decision = with (Search = stats) { decide(s, difficulty.downcast_unchecked()) }
            let action = decision.action
            assert(is_legal(s, action))
            with (DecisionHistory = decisions) { remember_decision(decision, length) }
            s = apply(s, action)
            trace[length] = action
            length += 1
            if mode == 3 { break }
        }
    }

    out(0)
    field(7)
    field(difficulty.downcast_unchecked())
    field(small(length))
    write_char(10)
    var last = pass()
    if length > 0 { last = trace[length - 1] }
    out(1)
    field(s.side)
    field(s.orders)
    field(s.turn)
    field(s.result)
    field(s.gold[1])
    field(s.gold[2])
    field(s.passes)
    field(last.kind)
    field(small(last.from))
    field(small(last.to))
    field(last.amount)
    field(stats.nodes)
    field(if difficulty == 0 { 1 } else { 4 })
    field(s.completed_rounds)
    field(s.round_limit)
    field(if s.decision_pending { 1 } else { 0 })
    field(if length >= TRACE_CAPACITY { 1 } else { 0 })
    write_char(10)

    out(6)
    field(small(map_width(s)))
    field(small(map_height(s)))
    field(small(tile_count(s)))
    field(1)
    field(small(s.scenario))
    field(small(capital(s, 1)))
    field(small(capital(s, 2)))
    field(2)
    field(base_round_limit(s.scenario))
    field(EXTENSION_ROUNDS)
    field(small(TRACE_CAPACITY))
    write_char(10)
    emit_economy(s, 1)
    emit_economy(s, 2)
    for side in 1 .. 3 {
        let player: i64 = side.downcast_unchecked()
        let count = supply_count(s, player)
        out(8)
        field(player)
        field(count.connected)
        field(count.cut_off)
        write_char(10)
    }

    let blue = supply(s, 1)
    let red = supply(s, 2)
    for i in 0 .. tile_count(s) {
        let supplied = (s.owner[i] == 1 && blue[i]) || (s.owner[i] == 2 && red[i])
        out(2)
        field(small(i))
        field(s.owner[i])
        field(s.troops[i])
        field(s.fort[i])
        field(if supplied { 1 } else { 0 })
        field(terrain(s, i))
        field(small(i % map_width(s)))
        field(small(i / map_width(s)))
        field(s.settlement[i])
        field(if passable(s, i) { 1 } else { 0 })
        field(if supplied { army_upkeep(s.troops[i]) } else { 0 })
        let army = army_at(s, i)
        field(army.infantry)
        field(army.cavalry)
        field(army.siege)
        field(defense(s, i))
        field(s.specialty[i])
        field(if crossing_bit(s, i) > 0 { 1 } else { 0 })
        field(if constructed_bridge(s, i) { 1 } else { 0 })
        write_char(10)
    }
    // No recordable action remains when the replay buffer is full.
    let choices = if length >= TRACE_CAPACITY { empty_actions() } else { legal(s) }
    for i in 0 .. choices.len { emit_action(3, choices.items[i]) }
    // Forecasts call apply(), not a second implementation of costs or combat.
    let player: usize = s.side.downcast_unchecked()
    for i in 0 .. choices.len {
        let action = choices.items[i]
        let after = apply(s, action)
        var outcome: i64 = 0
        if action.kind == 2 || (action.kind >= 5 && action.kind <= 8) { outcome = 4 }
        else if action.kind == 3 { outcome = 5 }
        else if action.kind == 4 { outcome = 6 }
        else if action.kind == 11 { outcome = 7 }
        else if action.kind == 12 { outcome = 8 }
        else if action.kind == 1 {
            if s.owner[action.to] == s.side { outcome = 1 }
            else if after.owner[action.to] == s.side { outcome = 2 }
            else { outcome = 3 }
        }
        out(5)
        field(small(i))
        field(outcome)
        field(s.gold[player] - after.gold[player])
        field(after.troops[action.from])
        field(after.troops[action.to])
        field(after.owner[action.to])
        field(after.side)
        field(after.orders)
        field(after.result)
        field(if action.kind == 1 && s.owner[action.to] != s.side { defense(s, action.to) } else { 0 })
        field(s.food[player] - after.food[player])
        field(after.settlement[action.to])
        field(after.food[1])
        field(after.food[2])
        var moving = empty_army()
        var power: i64 = 0
        if action.kind == 1 {
            moving = detachment(army_at(s, action.from), action.amount)
            if s.owner[action.to] != s.side { power = attack_power(s, action.to, moving) }
        }
        let source = army_at(after, action.from)
        let target = army_at(after, action.to)
        field(moving.infantry)
        field(moving.cavalry)
        field(moving.siege)
        field(power)
        field(source.infantry)
        field(source.cavalry)
        field(source.siege)
        field(target.infantry)
        field(target.cavalry)
        field(target.siege)
        let after_blue = supply_count(after, 1)
        let after_red = supply_count(after, 2)
        field(after_blue.connected)
        field(after_blue.cut_off)
        field(after_red.connected)
        field(after_red.cut_off)
        field(order_cost(s, action))
        field(after.specialty[action.to])
        field(terrain(after, action.to))
        field(if passable(after, action.to) { 1 } else { 0 })
        write_char(10)
    }
    for i in 0 .. length {
        out(4)
        field(small(i))
        field(trace[i].kind)
        field(small(trace[i].from))
        field(small(trace[i].to))
        field(trace[i].amount)
        write_char(10)
    }
    for i in 0 .. decisions.len { emit_decision(decisions.items[i], decisions.trace_indices[i]) }
    0
}
pub fn main() -> i32 {
    var input = Input { look: -1, started: false, ok: true, bytes: 0 }
    var reader = host()
    var writer = host()
    let code = with (Input = input, Read = reader, Write = writer) { run() }
    if writer.failed() { 3 } else { code }
}
