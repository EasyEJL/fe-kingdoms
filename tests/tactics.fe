// Test-only bounded tactical oracle. All legality, transitions, scoring and
// production policy decisions come from the unchanged authoritative Fe engine.
struct TacticalWins { count: i64, length: i64, first: Action, second: Action }
fn tactical_wins(_ s: State) -> TacticalWins {
    var found = TacticalWins { count: 0, length: 0, first: pass(), second: pass() }
    assert(s.result == 0 && !s.decision_pending && s.side == 1)
    assert(s.orders > 0 && s.orders <= 2)
    let first = legal(s)
    for i in 0 .. first.len {
        let next = apply(s, first.items[i])
        if next.result == 1 {
            found.count += 1
            if found.length == 0 { found.length = 1
                found.first = first.items[i] }
        } else if next.result == 0 && !next.decision_pending && next.side == 1 {
            let second = legal(next)
            for j in 0 .. second.len {
                if apply(next, second.items[j]).result == 1 {
                    found.count += 1
                    if found.length == 0 { found.length = 2
                        found.first = first.items[i]
                        found.second = second.items[j] }
                }
            }
        }
    }
    found
}
fn tactical_action_fields(_ a: Action) uses (writer: mut Write) {
    field(a.kind)
    field(small(a.from))
    field(small(a.to))
    field(a.amount)
}
fn tactical_rank(_ s: State, _ a: Action) -> i64 uses (Navigation) {
    let ordered = ranked(s, 2)
    for i in 0 .. ordered.len { if same_action(ordered.items[i], a) { return small(i) } }
    -1
}
// Emit every winning line, not merely the first witness. Ranks are zero-based
// production beam ordering from Red's perspective, not an alternative policy.
fn tactical_emit_path(_ label: i64, _ s: State, _ a: Action, _ b: Action, _ length: i64)
    uses (Navigation, writer: mut Write) {
    out(5)
    field(label)
    field(length)
    tactical_action_fields(a)
    tactical_action_fields(b)
    field(tactical_rank(s, a))
    field(if length == 2 { tactical_rank(apply(s, a), b) } else { -1 })
    write_char(10)
}
fn tactical_emit_wins(_ tag: i64, _ label: i64, _ s: State) uses (Navigation, writer: mut Write) {
    let wins = tactical_wins(s)
    out(tag)
    field(label)
    field(wins.count)
    field(wins.length)
    tactical_action_fields(wins.first)
    tactical_action_fields(wins.second)
    field(if wins.length > 0 { tactical_rank(s, wins.first) } else { -1 })
    field(if wins.length == 2 { tactical_rank(apply(s, wins.first), wins.second) } else { -1 })
    write_char(10)
    if wins.count == 0 { return }
    let first = legal(s)
    var emitted: i64 = 0
    for i in 0 .. first.len {
        let next = apply(s, first.items[i])
        if next.result == 1 {
            tactical_emit_path(label, s, first.items[i], pass(), 1)
            emitted += 1
        } else if next.result == 0 && !next.decision_pending && next.side == 1 {
            let second = legal(next)
            for j in 0 .. second.len {
                if apply(next, second.items[j]).result == 1 {
                    tactical_emit_path(label, s, first.items[i], second.items[j], 2)
                    emitted += 1
                }
            }
        }
    }
    assert(emitted == wins.count)
}
fn tactical_audit(_ s: State) uses (Navigation, writer: mut Write) {
    assert(s.result == 0 && !s.decision_pending && s.side == 2 && s.orders == 2)
    out(0)
    field(s.side)
    field(s.orders)
    field(s.turn)
    write_char(10)
    for difficulty in 0 .. 2 {
        let level: i64 = difficulty.downcast_unchecked()
        var current = s
        var stats = Search { nodes: 0 }
        var orders: i64 = 0
        while current.side == 2 && current.result == 0 && !current.decision_pending {
            assert(orders < 2)
            let action = with (Search = stats) { choose_cached(current, level) }
            assert(is_legal(current, action))
            out(1)
            field(level)
            field(orders)
            tactical_action_fields(action)
            field(tactical_rank(current, action))
            current = apply(current, action)
            field(evaluate_cached(current, 2))
            write_char(10)
            orders += 1
        }
        assert(current.result == 0 && !current.decision_pending && current.side == 1 && current.orders == 2)
        tactical_emit_wins(2, level, current)
    }
    let first = ranked(s, 2)
    var completions: i64 = 0
    var safe: i64 = 0
    for i in 0 .. first.len {
        let next = apply(s, first.items[i])
        var local_completions: i64 = 0
        var local_safe: i64 = 0
        var witness = pass()
        var witness_rank: i64 = -1
        if next.side != 2 || next.result != 0 || next.decision_pending {
            // These fixtures must reach an ordinary Blue turn. Draws, wins
            // and campaign-decision pauses are excluded, not counted safe.
            assert(next.result == 0 && !next.decision_pending && next.side == 1 && next.orders == 2)
            local_completions = 1
            if tactical_wins(next).count == 0 { local_safe = 1 }
        } else {
            let second = ranked(next, 2)
            for j in 0 .. second.len {
                let after = apply(next, second.items[j])
                assert(after.result == 0 && !after.decision_pending && after.side == 1 && after.orders == 2)
                local_completions += 1
                if tactical_wins(after).count == 0 {
                    local_safe += 1
                    if witness_rank < 0 { witness = second.items[j]
                        witness_rank = small(j) }
                }
            }
        }
        var stats = Search { nodes: 0 }
        let value = with (Search = stats) { search_cached(next, 3, 2, -200000, 200000) }
        out(3)
        field(small(i))
        tactical_action_fields(first.items[i])
        field(evaluate_cached(next, 2))
        field(value)
        field(local_completions)
        field(local_safe)
        field(witness_rank)
        tactical_action_fields(witness)
        write_char(10)
        completions += local_completions
        safe += local_safe
    }
    out(4)
    field(completions)
    field(safe)
    write_char(10)
}
fn tactical_run() -> i32 uses (input: mut Input, reader: mut Read, writer: mut Write) {
    let scenario = number()
    let count = number()
    if !input.ok || scenario > 2 || count > 2048 { return 2 }
    var s = initial(scenario.downcast_unchecked())
    let length: usize = count.downcast_unchecked()
    for i in 0 .. length {
        let kind = number()
        let from = number()
        let to = number()
        let amount = number()
        if !input.ok || kind > 10 || from > 63 || to > 63 || amount > 12 { return 2 }
        let action = Action { kind: kind.downcast_unchecked(), from: from.downcast_unchecked(),
            to: to.downcast_unchecked(), amount: amount.downcast_unchecked() }
        if !is_legal(s, action) { return 2 }
        s = apply(s, action)
    }
    if !input_done() { return 2 }
    let routes = navigation(s)
    with (Navigation = routes) {
        if s.side == 1 { tactical_emit_wins(2, 0, s) }
        else { tactical_audit(s) }
    }
    0
}
pub fn main() -> i32 {
    var input = Input { look: -1, started: false, ok: true, bytes: 0 }
    var reader = host()
    var writer = host()
    let code = with (Input = input, Read = reader, Write = writer) { tactical_run() }
    if writer.failed() { 3 } else { code }
}
