// Tests exercise Fe rules directly. Protocol/replay tests live in the host suite.
fn total_army(_ s: State, _ side: i64) -> i64 {
    var total: i64 = 0
    for i in 0 .. tile_count(s) { if s.owner[i] == side { total += s.troops[i] } }
    total
}
fn shortest_route(_ s: State, _ start: usize, _ goal: usize) -> i64 {
    var queue: [usize; 64] = [0; 64]
    var distance: [i64; 64] = [-1; 64]
    queue[0] = start
    distance[start] = 0
    var head: usize = 0
    var tail: usize = 1
    while head < tail {
        let current = queue[head]
        head += 1
        if current == goal { return distance[current] }
        for direction in 0 .. 6 {
            let next = neighbor(s, current, direction)
            if next < tile_count(s) && passable(s, next) && distance[next] < 0 {
                distance[next] = distance[current] + 1
                queue[tail] = next
                tail += 1
            }
        }
    }
    -1
}
fn check_bounds(_ s: State) {
    assert(s.orders >= 0 && s.orders <= 2)
    assert(s.bridge_mask < 4)
    for side in 1 .. 3 {
        assert(s.developments[side] <= 7)
        assert(s.gold[side] >= 0 && s.gold[side] <= 40)
        assert(s.food[side] >= 0 && s.food[side] <= 40)
    }
    for i in 0 .. tile_count(s) {
        assert(s.owner[i] >= 0 && s.owner[i] <= 2)
        assert(s.fort[i] >= 0 && s.fort[i] <= 2)
        assert(s.settlement[i] >= 0 && s.settlement[i] <= 2)
        assert(s.specialty[i] >= 0 && s.specialty[i] <= 2)
        if s.specialty[i] > 0 { assert(s.settlement[i] == 2) }
        let army = army_at(s, i)
        assert(army.infantry >= 0 && army.cavalry >= 0 && army.siege >= 0)
        assert(army_size(army) == s.troops[i])
        if passable(s, i) {
            if constructed_bridge(s, i) && s.owner[i] == 0 { assert(s.troops[i] == 0 && s.fort[i] == 0 && s.settlement[i] == 0) }
            else { assert(s.troops[i] >= 1 && s.troops[i] <= 12) }
        }
        else { assert(s.owner[i] == 0 && s.troops[i] == 0 && s.settlement[i] == 0) }
    }
}
#[test]
fn three_symmetric_hex_maps() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        let width = map_width(s)
        let last = tile_count(s) - 1
        assert(width == 5 + scenario * 2)
        assert(tile_count(s) <= 64)
        assert(s.gold[1] == s.gold[2] && s.food[1] == s.food[2])
        for a in 0 .. tile_count(s) {
            assert(terrain(s, a) == terrain(s, last - a))
            assert(s.troops[a] == s.troops[last - a])
            assert(s.settlement[a] == s.settlement[last - a])
            var degree: usize = 0
            for b in 0 .. tile_count(s) {
                assert(adjacent(s, a, b) == adjacent(s, b, a))
                assert(adjacent(s, a, b) == adjacent(s, last - a, last - b))
                if adjacent(s, a, b) { degree += 1 }
            }
            assert(degree <= 6)
        }
        assert(!adjacent(s, width - 1, width))
        assert(adjacent(s, 1, width))
        check_bounds(s)
    }
}
#[test]
fn route_evaluation_respects_all_chokepoints() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        for a in 0 .. tile_count(s) {
            if passable(s, a) {
                for b in 0 .. tile_count(s) {
                    if passable(s, b) {
                        assert(travel_distance(s, a, b) == shortest_route(s, a, b))
                    }
                }
            }
        }
    }
}
#[test]
fn rivers_and_mountains_are_not_legal_targets() {
    var s = initial(0)
    s.troops[1] = 6
    assert(terrain(s, 2) == 8 && !passable(s, 2))
    assert(terrain(s, 4) == 5 && !passable(s, 4))
    assert(!is_legal(s, Action { kind: 1, from: 1, to: 2, amount: 5 }))
    let choices = legal(s)
    for i in 0 .. choices.len {
        if choices.items[i].kind == 1 { assert(passable(s, choices.items[i].to)) }
    }
}
#[test]
fn starting_economy_is_generous_and_equal() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        let blue = economy(s, 1)
        let red = economy(s, 2)
        assert(blue.gold_income == 3 && red.gold_income == 3)
        assert(blue.food_production == 5 && red.food_production == 5)
        assert(blue.food_upkeep == 3 && red.food_upkeep == 3)
        assert(blue.shortage == 0 && red.shortage == 0)
        assert(blue.disconnected == 0 && red.disconnected == 0)
    }
}
#[test]
fn recruitment_costs_and_two_order_handoff() {
    var s = initial(0)
    let recruit = Action { kind: 2, from: 0, to: 0, amount: 2 }
    assert(is_legal(s, recruit))
    s = apply(s, recruit)
    assert(s.troops[0] == 8 && s.gold[1] == 5 && s.food[1] == 10)
    assert(s.orders == 1 && s.side == 1)
    s = apply(s, recruit)
    assert(s.troops[0] == 10 && s.gold[1] == 2 && s.food[1] == 8)
    assert(s.side == 2 && s.orders == 2 && s.gold[2] == 11 && s.food[2] == 14)
    assert(!is_legal(s, recruit))
}
#[test]
fn recruit_requires_supplied_settlement_and_food() {
    var s = initial(0)
    assert(!is_legal(s, Action { kind: 2, from: 1, to: 1, amount: 2 }))
    assert(is_legal(s, Action { kind: 2, from: 5, to: 5, amount: 2 }))
    s.food[1] = 1
    assert(!is_legal(s, Action { kind: 2, from: 5, to: 5, amount: 2 }))
    s.food[1] = 12
    s.owner[0] = 2
    assert(!is_legal(s, Action { kind: 2, from: 5, to: 5, amount: 2 }))
}
#[test]
fn villages_and_towns_are_real_orders() {
    var s = initial(0)
    let village = Action { kind: 4, from: 1, to: 1, amount: 1 }
    assert(is_legal(s, village))
    s = apply(s, village)
    assert(s.settlement[1] == 1 && s.gold[1] == 2 && s.orders == 1)
    assert(economy(s, 1).gold_income == 4)
    let town = Action { kind: 4, from: 1, to: 1, amount: 2 }
    assert(!is_legal(s, town))
    s.gold[1] = 8
    s = apply(s, town)
    assert(s.settlement[1] == 2 && s.gold[1] == 0)
    assert(economy(s, 1).gold_income == 5)
    s.side = 1
    s.gold[1] = 40
    assert(!is_legal(s, Action { kind: 4, from: 1, to: 1, amount: 3 }))
    assert(!is_legal(s, Action { kind: 4, from: 0, to: 0, amount: 1 }))
}
#[test]
fn pass_capture_and_defense_forecast_rules() {
    var s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 3
    assert(defense(s, 7) == 2)
    s = apply(s, Action { kind: 1, from: 6, to: 7, amount: 2 })
    assert(s.owner[7] == 0 && s.troops[7] == 1)
    s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 4
    s = apply(s, Action { kind: 1, from: 6, to: 7, amount: 3 })
    assert(s.owner[7] == 1 && s.troops[7] == 1)
}
#[test]
fn supply_cut_stops_income_and_causes_attrition() {
    var s = initial(0)
    s.owner[6] = 1
    s.owner[7] = 1
    s.owner[8] = 1
    s.troops[8] = 5
    assert(supply(s, 1)[8])
    let before = economy(s, 1)
    s.owner[7] = 2
    assert(!supply(s, 1)[8])
    let cut = economy(s, 1)
    assert(cut.disconnected == 1 && cut.gold_income == before.gold_income - 1)
    s = begin_turn(s)
    assert(s.troops[8] == 4)
    assert(!is_legal(s, Action { kind: 2, from: 8, to: 8, amount: 2 }))
}
#[test]
fn food_shortage_forecast_equals_actual_losses() {
    var s = initial(0)
    for i in 0 .. tile_count(s) {
        if passable(s, i) && i != capital(s, 2) {
            s.owner[i] = 1
            s.troops[i] = 12
        }
    }
    s.food[1] = 0
    let budget = economy(s, 1)
    assert(budget.shortage > 0 && budget.disconnected == 0)
    let count = total_army(s, 1)
    s = begin_turn(s)
    assert(s.food[1] == 0)
    assert(count - total_army(s, 1) == budget.shortage)
    check_bounds(s)
}
#[test]
fn resource_caps_and_lone_garrisons() {
    var s = initial(0)
    s.gold[1] = 40
    s.food[1] = 40
    for i in 0 .. tile_count(s) {
        if s.owner[i] == 1 { s.troops[i] = 1 }
    }
    assert(economy(s, 1).food_upkeep == 0)
    s = begin_turn(s)
    assert(s.gold[1] == 40 && s.food[1] == 40)
}
#[test]
fn capital_victory_and_stalemate() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        let home = capital(s, 2)
        s.owner[home - 1] = 1
        s.troops[home - 1] = 10
        s = apply(s, Action { kind: 1, from: home - 1, to: home, amount: 9 })
        assert(s.result == 1 && s.troops[home] == 2 && legal(s).len == 0)
        assert(supply_count(s, 2).connected == 0 && supply_count(s, 2).cut_off > 0)
        s = initial(scenario)
        for _i in 0 .. 4 { s = apply(s, pass()) }
        assert(s.result == 3)
    }
}
#[test]
fn all_generated_orders_preserve_bounds() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        var seed: usize = 17
        for step in 0 .. 2048 {
            if s.result != 0 { break }
            if s.decision_pending { s = apply(s, extend_campaign()) }
            let choices = legal(s)
            assert(choices.len > 0 && choices.len < MAX_ACTIONS)
            if step < 20 {
                for i in 0 .. choices.len { check_bounds(apply(s, choices.items[i])) }
            }
            seed = (seed * 251 + 13849) % 65521
            s = apply(s, choices.items[seed % choices.len])
            check_bounds(s)
        }
        // A bounded test budget is not a game-ending rule.
        check_bounds(s)
    }
}
#[test]
fn both_difficulties_take_capital_wins() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        let home = capital(s, 2)
        s.owner[home - 1] = 1
        s.troops[home - 1] = 10
        for difficulty in 0 .. 2 {
            var stats = Search { nodes: 0 }
            let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
            assert(is_legal(s, action) && apply(s, action).result == 1)
            assert(stats.nodes > 0)
        }
    }
}
#[test]
fn hard_search_remains_deeper_and_deterministic() {
    var s = initial(0)
    s = apply(s, pass())
    var easy = Search { nodes: 0 }
    var hard = Search { nodes: 0 }
    var repeat = Search { nodes: 0 }
    let a = with (Search = easy) { choose(s, 0) }
    let b = with (Search = hard) { choose(s, 1) }
    let c = with (Search = repeat) { choose(s, 1) }
    assert(is_legal(s, a) && is_legal(s, b) && same_action(b, c))
    assert(hard.nodes > easy.nodes && hard.nodes == repeat.nodes)
}

#[test]
fn capped_food_projection_uses_the_real_turn_transition() {
    var s = initial(0)
    s.food[1] = 40
    let budget = economy(s, 1)
    assert(budget.food_production - budget.food_upkeep == 2)
    let actual = begin_turn(s)
    assert(actual.food[1] == 37)
    assert(actual.food[2] == s.food[2])
}

// TROOP ROLE INVARIANTS AND TACTICS
fn same_army(_ a: Army, _ b: Army) -> bool {
    a.infantry == b.infantry && a.cavalry == b.cavalry && a.siege == b.siege
}
#[test]
fn every_bounded_composition_detaches_and_merges_exactly() {
    for total in 2 .. 13 {
        for cavalry in 0 .. total + 1 {
            for siege in 0 .. total - cavalry + 1 {
                let army = Army {
                    infantry: (total - cavalry - siege).downcast_unchecked(),
                    cavalry: cavalry.downcast_unchecked(), siege: siege.downcast_unchecked(),
                }
                for amount in 1 .. total {
                    let moving = detachment(army, amount.downcast_unchecked())
                    let left = subtract_armies(army, moving)
                    assert(army_size(moving) == amount.downcast_unchecked())
                    assert(army_size(left) >= 1)
                    assert(left.infantry >= 0 && left.cavalry >= 0 && left.siege >= 0)
                    assert(moving.infantry >= 0 && moving.cavalry >= 0 && moving.siege >= 0)
                    assert(same_army(combine_armies(left, moving), army))
                    if army.infantry > 0 { assert(left.infantry >= 1) }
                    else if army.cavalry > 0 { assert(left.cavalry >= 1) }
                    else { assert(left.siege >= 1) }
                    assert(same_army(moving, detachment(army, amount.downcast_unchecked())))
                }
            }
        }
    }
    let balanced = detachment(Army { infantry: 4, cavalry: 2, siege: 2 }, 4)
    assert(same_army(balanced, Army { infantry: 2, cavalry: 1, siege: 1 }))
}
#[test]
fn specialist_recruitment_and_training_are_explicit_paid_orders() {
    var s = initial(0)
    let cavalry = Action { kind: 5, from: 5, to: 5, amount: 1 }
    assert(!is_legal(s, cavalry))
    s.settlement[5] = 2
    assert(is_legal(s, cavalry))
    s = apply(s, cavalry)
    assert(s.troops[5] == 2 && s.cavalry[5] == 1 && army_at(s, 5).infantry == 1)
    assert(s.gold[1] == 4 && s.food[1] == 10 && s.orders == 1)
    assert(!is_legal(s, Action { kind: 6, from: 5, to: 5, amount: 1 }))
    s.gold[1] = 40
    s.troops[5] = 12
    let train = Action { kind: 8, from: 5, to: 5, amount: 1 }
    assert(!is_legal(s, cavalry) && is_legal(s, train))
    let before = army_at(s, 5)
    s = apply(s, train)
    assert(s.troops[5] == 12 && s.siege[5] == 1 && s.cavalry[5] == 1)
    assert(army_at(s, 5).infantry == before.infantry - 1)
    assert(s.gold[1] == 35 && s.food[1] == 7)
    s.side = 1
    s.troops[5] = 2
    assert(army_at(s, 5).infantry == 0)
    assert(!is_legal(s, Action { kind: 7, from: 5, to: 5, amount: 1 }))
    s.owner[0] = 2
    assert(!is_legal(s, Action { kind: 6, from: 5, to: 5, amount: 1 }))
}
#[test]
fn role_power_depends_on_target_and_infantry_combat_is_unchanged() {
    var s = initial(0)
    let mixed = Army { infantry: 2, cavalry: 2, siege: 2 }
    assert(attack_power(s, 11, mixed) == 8)
    assert(attack_power(s, 7, mixed) == 6)
    s.fort[7] = 2
    assert(attack_power(s, 7, mixed) == 10)
    assert(attack_power(s, 14, mixed) == 10)
    // The forest village is no longer open ground: siege helps, cavalry does not.
    assert(attack_power(s, 6, mixed) == 10)
    for troops in 2 .. 13 {
        let count: i64 = troops.downcast_unchecked()
        let infantry = Army { infantry: count, cavalry: 0, siege: 0 }
        for target_defense in 1 .. troops {
            let protection: i64 = target_defense.downcast_unchecked()
            assert(capture_losses(infantry, count, protection) == protection)
        }
    }
}
#[test]
fn mixed_capture_repel_merge_and_losses_preserve_roles() {
    var s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 8
    s.cavalry[6] = 2
    s.siege[6] = 2
    let moving = detachment(army_at(s, 6), 7)
    let combined = combine_armies(army_at(s, 5), moving)
    let friendly = apply(s, Action { kind: 1, from: 6, to: 5, amount: 7 })
    assert(same_army(army_at(friendly, 5), combined))
    assert(same_army(army_at(friendly, 6), Army { infantry: 1, cavalry: 0, siege: 0 }))
    s.owner[7] = 2
    s.troops[7] = 9
    s.fort[7] = 2
    s.cavalry[7] = 2
    s.siege[7] = 1
    let repelled = apply(s, Action { kind: 1, from: 6, to: 7, amount: 7 })
    assert(repelled.owner[7] == 2 && repelled.troops[6] == 1)
    assert(repelled.troops[7] == 1 && repelled.siege[7] == 1)
    s.troops[7] = 3
    let captured = apply(s, Action { kind: 1, from: 6, to: 7, amount: 7 })
    assert(captured.owner[7] == 1 && captured.fort[7] == 0)
    assert(captured.siege[7] == 2)
    check_bounds(captured)
}
#[test]
fn attrition_and_hunger_use_the_same_casualty_priority() {
    assert(same_army(lose_troops(Army { infantry: 2, cavalry: 2, siege: 2 }, 3),
        Army { infantry: 0, cavalry: 1, siege: 2 }))
    var s = initial(0)
    s.owner[8] = 1
    s.troops[8] = 3
    s.cavalry[8] = 1
    s.siege[8] = 1
    s = begin_turn(s)
    assert(same_army(army_at(s, 8), Army { infantry: 0, cavalry: 1, siege: 1 }))
    s = begin_turn(s)
    assert(same_army(army_at(s, 8), Army { infantry: 0, cavalry: 0, siege: 1 }))
    s = begin_turn(s)
    assert(same_army(army_at(s, 8), Army { infantry: 0, cavalry: 0, siege: 1 }))
}
fn fortified_frontline() -> State {
    var s = initial(0)
    for i in 0 .. tile_count(s) {
        if passable(s, i) {
            if i % map_width(s) < map_width(s) / 2 {
                s.owner[i] = 1
                s.troops[i] = 12
            }
        }
    }
    s.settlement[6] = 2
    s.owner[7] = 2
    s.owner[8] = 2
    s.troops[7] = 12
    s.fort[7] = 2
    s.orders = 1
    s.gold = [0, 40, 40]
    s.food = [0, 40, 40]
    s
}
#[test]
fn full_frontline_can_train_and_breach_the_fortified_pass() {
    for difficulty in 0 .. 2 {
        var s = fortified_frontline()
        let train = Action { kind: 8, from: 6, to: 6, amount: 1 }
        assert(defense(s, 7) == 15)
        assert(!is_legal(s, Action { kind: 6, from: 6, to: 6, amount: 1 }))
        assert(is_legal(s, train))
        var stats = Search { nodes: 0 }
        let chosen = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(chosen.kind == 8 && chosen.from == 6)
        s.orders = 2
        s = apply(s, train)
        s = apply(s, train)
        s = apply(s, pass())
        s = apply(s, train)
        // The siege assault needs both orders. End this preparation turn and
        // the opponent's quiet fixture turn rather than applying an illegal move.
        s = apply(s, pass())
        s = apply(s, pass())
        let assault = Action { kind: 1, from: 6, to: 7, amount: 11 }
        assert(is_legal(s, assault) && order_cost(s, assault) == 2)
        assert(attack_power(s, 7, detachment(army_at(s, 6), 11)) == 17)
        let attack = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(same_action(attack, assault))
        s = apply(s, assault)
        assert(s.owner[7] == 1 && s.troops[7] >= 1)
        check_bounds(s)
    }
}
#[test]
fn both_policies_take_specialist_capital_wins() {
    var s = initial(0)
    s.owner[13] = 1
    s.troops[13] = 12
    s.siege[13] = 2
    s.troops[14] = 12
    s.fort[14] = 2
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(apply(s, action).result == 1)
    }
}

// CAMPAIGN BOUNDARIES: these use legal, reversible friendly moves rather than
// consecutive passes, so long-run checks cannot accidentally test stalemate.
fn cycle_order(_ s: State) -> Action {
    let home = capital(s, s.side)
    let nearby = if s.side == 1 { home + 1 } else { home - 1 }
    if s.orders == 2 { Action { kind: 1, from: home, to: nearby, amount: 3 } }
    else { Action { kind: 1, from: nearby, to: home, amount: 3 } }
}
fn campaign_boundary(_ scenario: usize) -> State {
    var s = initial(scenario)
    for _step in 0 .. 720 {
        if s.decision_pending { break }
        let action = cycle_order(s)
        assert(is_legal(s, action))
        s = apply(s, action)
        check_bounds(s)
    }
    assert(s.decision_pending && s.result == 0)
    s
}
#[test]
fn scenario_boundaries_are_full_rounds_and_never_automatic_draws() {
    for scenario in 0 .. 3 {
        let s = campaign_boundary(scenario)
        assert(s.completed_rounds == base_round_limit(scenario))
        assert(s.round_limit == base_round_limit(scenario))
        assert(s.turn == s.round_limit * 2 && s.side == 2 && s.orders == 0)
        assert(s.passes == 0)
        let choices = legal(s)
        assert(choices.len == 2)
        assert(same_action(choices.items[0], extend_campaign()))
        assert(same_action(choices.items[1], accept_draw()))
        assert(!is_legal(s, pass()) && !is_legal(s, cycle_order(s)))
        assert(!is_legal(s, Action { kind: 9, from: 0, to: 0, amount: 1 }))
        assert(!is_legal(initial(scenario), extend_campaign()))
        assert(!is_legal(initial(scenario), accept_draw()))
        let drawn = apply(s, accept_draw())
        assert(drawn.result == 3 && !drawn.decision_pending && legal(drawn).len == 0)
        assert(drawn.completed_rounds == s.completed_rounds && drawn.turn == s.turn)
        assert(drawn.gold[1] == s.gold[1] && drawn.food[1] == s.food[1])
    }
}
#[test]
fn extension_pays_one_deferred_turn_without_spending_an_order() {
    var s = campaign_boundary(0)
    // Force uncapped resources and an isolated stack to expose double payment
    // or duplicate attrition that capped resources alone would conceal.
    s.gold[1] = 0
    s.food[1] = 10
    s.owner[8] = 1
    s.troops[8] = 5
    var expected = s
    expected.side = 1
    expected = begin_turn(expected)
    let continued = apply(s, extend_campaign())
    assert(continued.side == 1 && continued.orders == 2 && continued.turn == 121)
    assert(continued.round_limit == 80 && continued.completed_rounds == 60)
    assert(!continued.decision_pending && continued.result == 0)
    assert(continued.gold[1] == expected.gold[1] && continued.food[1] == expected.food[1])
    assert(continued.gold[2] == s.gold[2] && continued.food[2] == s.food[2])
    assert(continued.troops[8] == 4)
    assert(supply_count(continued, 1).connected == supply_count(s, 1).connected)
    assert(supply_count(continued, 1).cut_off == supply_count(s, 1).cut_off)
    assert(!is_legal(continued, extend_campaign()))
    assert(!is_legal(continued, accept_draw()))
}
#[test]
fn victory_and_four_passes_precede_round_decision() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        s.side = 2
        s.orders = 1
        s.turn = base_round_limit(scenario) * 2
        s.completed_rounds = base_round_limit(scenario) - 1
        s.passes = 3
        let drawn = apply(s, pass())
        assert(drawn.result == 3 && !drawn.decision_pending)
        assert(drawn.completed_rounds == base_round_limit(scenario))
        s.owner[1] = 2
        s.troops[1] = 10
        let attack = Action { kind: 1, from: 1, to: 0, amount: 9 }
        assert(is_legal(s, attack))
        let won = apply(s, attack)
        assert(won.result == 2 && !won.decision_pending && legal(won).len == 0)
        for difficulty in 0 .. 2 {
            var stats = Search { nodes: 0 }
            let chosen = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
            assert(apply(s, chosen).result == 2)
        }
    }
}
#[test]
fn boundary_search_is_a_leaf_not_an_ai_campaign_vote() {
    let s = campaign_boundary(0)
    var stats = Search { nodes: 0 }
    let score = with (Search = stats) { search(s, 3, 2, -200000, 200000) }
    assert(score == evaluate(s, 2) && stats.nodes == 1)
}
fn same_campaign(_ a: State, _ b: State) -> bool {
    if a.side != b.side || a.orders != b.orders || a.turn != b.turn || a.result != b.result
        || a.passes != b.passes || a.completed_rounds != b.completed_rounds
        || a.round_limit != b.round_limit || a.decision_pending != b.decision_pending || a.bridge_mask != b.bridge_mask { return false }
    for side in 0 .. 3 { if a.gold[side] != b.gold[side] || a.food[side] != b.food[side]
        || a.developments[side] != b.developments[side] { return false } }
    for i in 0 .. tile_count(a) {
        if a.owner[i] != b.owner[i] || a.troops[i] != b.troops[i]
            || a.fort[i] != b.fort[i] || a.settlement[i] != b.settlement[i] || a.specialty[i] != b.specialty[i]
            || !same_army(army_at(a, i), army_at(b, i)) { return false }
    }
    true
}
#[test]
fn extended_campaign_replay_and_bounds_survive_full_trace_capacity() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        var trace = [pass(); 2048]
        var extensions: i64 = 0
        for step in 0 .. TRACE_CAPACITY {
            let action = if s.decision_pending { extend_campaign() } else { cycle_order(s) }
            if action.kind == 9 { extensions += 1 }
            assert(is_legal(s, action))
            trace[step] = action
            s = apply(s, action)
            assert(s.result == 0)
            check_bounds(s)
            if step == 240 { assert(s.turn > 120) }
        }
        assert(extensions > 0 && s.completed_rounds > 180)
        assert(s.round_limit == base_round_limit(scenario) + extensions * EXTENSION_ROUNDS)
        var replay = initial(scenario)
        for step in 0 .. TRACE_CAPACITY {
            assert(is_legal(replay, trace[step]))
            replay = apply(replay, trace[step])
        }
        assert(same_campaign(s, replay))
    }
}

#[test]
fn fixed_rivers_bridges_and_cached_capital_routes_match_oracle() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        let routes = navigation(s)
        var bridges: i64 = 0
        for i in 0 .. tile_count(s) {
            if terrain(s, i) == 9 {
                bridges += 1
                assert(passable(s, i) && defense(s, i) == s.troops[i] + s.fort[i] + 1)
                let cavalry = Army { infantry: 0, cavalry: 3, siege: 0 }
                assert(attack_power(s, i, cavalry) == 3)
            }
            if passable(s, i) {
                assert(routes.blue[s.bridge_mask][i] == shortest_route(s, capital(s, 1), i))
                assert(routes.red[s.bridge_mask][i] == shortest_route(s, capital(s, 2), i))
                assert(routes.blue[s.bridge_mask][i] < 1000 && routes.red[s.bridge_mask][i] < 1000)
            } else {
                assert(routes.blue[s.bridge_mask][i] == 1000 && routes.red[s.bridge_mask][i] == 1000)
                assert(s.owner[i] == 0 && s.settlement[i] == 0)
            }
        }
        assert(bridges == if scenario == 0 { 1 } else { 2 })
        // Widened river forces a detour within the same side of the old ridge.
        if scenario > 0 {
            let a = map_width(s) + map_width(s) / 2 - 1
            let b = 3 * map_width(s) + map_width(s) / 2 - 1
            assert(travel_distance(s, a, b) > hex_distance(s, a, b))
        }
        for root in 1 .. 3 {
            let side: i64 = root.downcast_unchecked()
            let cached = with (Navigation = routes) { evaluate_cached(s, side) }
            assert(cached == evaluate(s, side))
        }
    }
}
fn bridge_cut_position() -> State {
    var s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 12
    s.siege[6] = 3
    s.owner[7] = 2
    s.troops[7] = 2
    s.owner[8] = 2
    s.owner[11] = 2
    // This army cannot immediately recapture a defended bridge; otherwise
    // Hard sensibly destroys the army first rather than making a fragile cut.
    s.troops[11] = 8
    s.fort[11] = 2
    s.settlement[11] = 2
    s.orders = 2
    s.gold = [0, 0, 0]
    s.food = [0, 40, 40]
    s
}
#[test]
fn both_policies_capture_bridge_and_cut_enemy_supply() {
    let s = bridge_cut_position()
    assert(supply(s, 2)[11] && supply_count(s, 2).cut_off == 0)
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let chosen = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(chosen.kind == 1 && chosen.from == 6 && chosen.to == 7)
        let after = apply(s, chosen)
        assert(after.owner[7] == 1 && !supply(after, 2)[11])
        assert(supply_count(after, 2).cut_off == 1)
        assert(after.troops[11] == 7)
        check_bounds(after)
    }
    // With a stronger army able to retake the bridge, Hard removes that
    // counterattack threat first. A compulsory immediate cut would be worse.
    var threatened = s
    threatened.troops[11] = 12
    var hard = Search { nodes: 0 }
    let preparation = with (Search = hard) { choose(threatened, 1) }
    assert(preparation.kind == 1 && preparation.from == 6 && preparation.to == 11)
    let secured = apply(threatened, preparation)
    assert(secured.owner[11] == 1)
    assert(total_army(secured, 2) == total_army(threatened, 2) - 12)
}
#[test]
fn supply_counts_distinguish_capture_cut_and_reconnection() {
    var s = bridge_cut_position()
    let before_blue = supply_count(s, 1)
    let before_red = supply_count(s, 2)
    let after = apply(s, Action { kind: 1, from: 6, to: 7, amount: 11 })
    let blue = supply_count(after, 1)
    let red = supply_count(after, 2)
    // Blue gained a captured tile, not a reconnected tile. Red lost a tile
    // and has one retained tile disconnected by the lost crossing.
    assert(blue.connected == before_blue.connected + 1 && blue.cut_off == 0)
    assert(red.connected == before_red.connected - 2 && red.cut_off == 1)
    s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 10
    s.owner[7] = 2
    s.owner[8] = 1
    s.troops[8] = 4
    s.gold[1] = 0
    assert(supply_count(s, 1).cut_off == 1)
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(action.kind == 1 && action.to == 7)
        let reconnected = apply(s, action)
        assert(supply_count(reconnected, 1).cut_off == 0)
        assert(supply_count(reconnected, 1).connected == supply_count(s, 1).connected + 2)
    }
    // Water cannot form a supply path, even in an intentionally invalid state.
    s.owner[2] = 1
    s.owner[3] = 1
    assert(!supply(s, 1)[2] && !supply(s, 1)[3])
}
#[test]
fn navigation_cache_is_scoped_to_one_decision() {
    let scenarios: [usize; 4] = [0, 2, 1, 0]
    for difficulty in 0 .. 2 {
        var first = pass()
        var first_nodes: i64 = 0
        for index in 0 .. 4 {
            let s = initial(scenarios[index])
            var stats = Search { nodes: 0 }
            let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
            assert(is_legal(s, action))
            if index == 0 { first = action
                first_nodes = stats.nodes }
            if index == 3 { assert(same_action(action, first) && stats.nodes == first_nodes) }
        }
    }
}

// V7 FORESTS AND DETACHMENT-SPECIFIC ORDER COSTS
#[test]
fn forests_are_symmetric_and_infantry_protection_is_small() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        var count: i64 = 0
        for i in 0 .. tile_count(s) {
            if terrain(s, i) == 10 {
                count += 1
                assert(passable(s, i) && terrain(s, tile_count(s) - 1 - i) == 10)
                assert(defense(s, i) == s.troops[i] + s.fort[i] + 1)
                s.troops[i] = 5
                s.cavalry[i] = 5
                assert(defense(s, i) == 5 + s.fort[i])
                s.cavalry[i] = 4
                assert(defense(s, i) == 6 + s.fort[i])
                s.cavalry[i] = 0
                assert(defense(s, i) == 6 + s.fort[i])
                assert(attack_power(s, i, Army { infantry: 0, cavalry: 3, siege: 0 }) == 3)
            }
        }
        assert(count == 2)
        assert(attack_power(s, 1, Army { infantry: 0, cavalry: 3, siege: 0 }) == 6)
    }
}
#[test]
fn one_order_can_move_infantry_while_leaving_specialists_behind() {
    for role in 1 .. 3 {
        var s = initial(0)
        s.orders = 1
        s.troops[5] = 5
        if role == 1 { s.cavalry[5] = 1 } else { s.siege[5] = 1 }
        let half = Action { kind: 1, from: 5, to: 6, amount: 2 }
        let full = Action { kind: 1, from: 5, to: 6, amount: 4 }
        assert(same_army(detachment(army_at(s, 5), 2), Army { infantry: 2, cavalry: 0, siege: 0 }))
        assert(order_cost(s, half) == 1 && is_legal(s, half))
        assert(order_cost(s, full) == 2 && !is_legal(s, full))
        // The neutral forest has one infantry and one protection: a tie repels.
        let after = apply(s, half)
        assert(after.owner[6] == 0 && after.side == 2 && after.orders == 2)
        assert(after.cavalry[5] == s.cavalry[5] && after.siege[5] == s.siege[5])
        s.orders = 2
        assert(is_legal(s, full))
        let capture = apply(s, full)
        assert(capture.owner[6] == 1 && capture.side == 2 && capture.orders == 2)
        check_bounds(capture)
    }
}
#[test]
fn every_detachment_pays_max_role_cost_and_friendly_moves_conserve_roles() {
    for total in 2 .. 13 {
        for cavalry in 0 .. total + 1 {
            for siege in 0 .. total - cavalry + 1 {
                var s = initial(0)
                s.owner[6] = 1
                s.troops[5] = total.downcast_unchecked()
                s.cavalry[5] = cavalry.downcast_unchecked()
                s.siege[5] = siege.downcast_unchecked()
                let original = combine_armies(army_at(s, 5), army_at(s, 6))
                for amount in 1 .. total {
                    let moving = detachment(army_at(s, 5), amount.downcast_unchecked())
                    let expected: i64 = if moving.cavalry > 0 || moving.siege > 0 { 2 } else { 1 }
                    assert(move_order_cost(s, 6, moving) == expected)
                    assert(move_order_cost(s, 1, moving) == if moving.siege > 0 { 2 } else { 1 })
                    if amount == total - 1 || amount == total / 2 {
                        let action = Action { kind: 1, from: 5, to: 6, amount: amount.downcast_unchecked() }
                        assert(is_legal(s, action) && order_cost(s, action) == expected)
                        let after = apply(s, action)
                        assert(same_army(combine_armies(army_at(after, 5), army_at(after, 6)), original))
                        assert(after.side == if expected == 2 { 2 } else { 1 })
                        assert(after.orders == if expected == 2 { 2 } else { 1 })
                        assert(after.gold[1] == s.gold[1] && after.food[1] == s.food[1])
                        check_bounds(after)
                        s.orders = 1
                        assert(is_legal(s, action) == (expected == 1))
                        s.orders = 2
                    }
                }
            }
        }
    }
}
#[test]
fn forest_opening_replays_and_old_small_attack_is_a_tie() {
    let opening = [Action { kind: 1, from: 0, to: 1, amount: 5 },
        Action { kind: 1, from: 1, to: 6, amount: 7 }]
    var s = initial(0)
    var replay = initial(0)
    for i in 0 .. 2 {
        assert(is_legal(s, opening[i]) && order_cost(s, opening[i]) == 1)
        s = apply(s, opening[i])
        replay = apply(replay, opening[i])
        check_bounds(s)
    }
    assert(s.owner[6] == 1 && s.troops[6] == 5 && s.side == 2)
    assert(same_campaign(s, replay))
    var old = initial(0)
    old = apply(old, Action { kind: 2, from: 5, to: 5, amount: 2 })
    let attack = Action { kind: 1, from: 5, to: 6, amount: 2 }
    assert(is_legal(old, attack))
    assert(attack_power(old, 6, detachment(army_at(old, 5), 2)) == defense(old, 6))
    assert(apply(old, attack).owner[6] == 0)
}
#[test]
fn both_policies_respect_two_order_siege_and_one_order_limits() {
    var s = initial(0)
    s.owner[13] = 1
    s.troops[13] = 12
    s.siege[13] = 2
    s.troops[14] = 12
    s.fort[14] = 2
    s.orders = 1
    let assault = Action { kind: 1, from: 13, to: 14, amount: 11 }
    assert(order_cost(s, assault) == 2 && !is_legal(s, assault))
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let chosen = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(is_legal(s, chosen) && order_cost(s, chosen) <= 1)
        assert(!same_action(chosen, assault))
    }
    s.orders = 2
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let chosen = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(is_legal(s, chosen) && order_cost(s, chosen) == 2)
        assert(apply(s, chosen).result == 1)
    }
    assert(order_cost(s, pass()) == 2)
    assert(order_cost(s, extend_campaign()) == 0 && order_cost(s, accept_draw()) == 0)
}

// V7 PERMANENT TOWN SPECIALTIES
#[test]
fn specialties_require_supplied_towns_and_pay_once_without_replacement() {
    for choice in 1 .. 3 {
        var s = initial(0)
        let action = Action { kind: 11, from: 5, to: 5, amount: choice.downcast_unchecked() }
        assert(!is_legal(s, action))
        s.settlement[5] = 2
        assert(is_legal(s, action))
        assert(!is_legal(s, Action { kind: 11, from: 5, to: 1, amount: action.amount }))
        assert(!is_legal(s, Action { kind: 11, from: 5, to: 5, amount: 0 }))
        assert(!is_legal(s, Action { kind: 11, from: 5, to: 5, amount: 3 }))
        s.gold[1] = 5
        assert(!is_legal(s, action))
        s.gold[1] = 6
        s.food[1] = 1
        assert(!is_legal(s, action))
        s.food[1] = 2
        s.owner[0] = 2
        assert(!is_legal(s, action))
        s.owner[0] = 1
        let before_army = army_at(s, 5)
        let after = apply(s, action)
        assert(after.specialty[5] == action.amount && after.settlement[5] == 2)
        assert(after.gold[1] == 0 && after.food[1] == 0 && after.orders == 1)
        assert(order_cost(s, action) == 1 && same_army(army_at(after, 5), before_army))
        s = after
        s.gold[1] = 40
        s.food[1] = 40
        assert(!is_legal(s, Action { kind: 11, from: 5, to: 5, amount: 1 }))
        assert(!is_legal(s, Action { kind: 11, from: 5, to: 5, amount: 2 }))
        check_bounds(s)
    }
}
#[test]
fn arsenal_discounts_recruitment_and_training_without_bypassing_caps_or_supply() {
    for kind in 5 .. 9 {
        var s = initial(0)
        s.settlement[5] = 2
        s.specialty[5] = 2
        let role: i64 = if kind == 5 || kind == 7 { 1 } else { 2 }
        let action = Action { kind: kind.downcast_unchecked(), from: 5, to: 5, amount: 1 }
        let gold = unit_profile(role).recruit_gold - 1
        let food = unit_profile(role).recruit_food
        s.gold[1] = gold
        s.food[1] = food
        if kind >= 7 { s.troops[5] = 12 }
        assert(recruitment_gold(s, 5, role, true) == gold)
        assert(recruitment_gold(s, 5, role, false) == gold + 1)
        assert(recruitment_gold(s, 5, 0, true) == 3)
        assert(is_legal(s, action))
        let before = army_at(s, 5)
        let after = apply(s, action)
        assert(after.gold[1] == 0 && after.food[1] == 0 && after.orders == 1)
        assert(after.troops[5] == s.troops[5] + if kind < 7 { 1 } else { 0 })
        assert(army_at(after, 5).infantry == before.infantry - if kind >= 7 { 1 } else { 0 })
        assert(after.cavalry[5] == if role == 1 { 1 } else { 0 })
        assert(after.siege[5] == if role == 2 { 1 } else { 0 })
        check_bounds(after)
        s.specialty[5] = 0
        assert(!is_legal(s, action))
        s.specialty[5] = 2
        s.owner[0] = 2
        assert(!is_legal(s, action))
        s.owner[0] = 1
        s.gold[1] = 40
        s.food[1] = 40
        if kind < 7 { s.troops[5] = 12 }
        else { s.cavalry[5] = s.troops[5] }
        assert(!is_legal(s, action))
    }
}
#[test]
fn granary_uses_real_capped_economy_and_capture_keeps_specialties() {
    var s = initial(0)
    s.settlement[5] = 2
    s.specialty[5] = 1
    assert(economy(s, 1).food_production == 7)
    s.food[1] = 40
    assert(begin_turn(s).food[1] == 37)
    s.food[1] = 0
    assert(begin_turn(s).food[1] == 4)
    for specialty in 1 .. 3 {
        s = initial(0)
        s.owner[6] = 1
        s.owner[7] = 1
        s.troops[7] = 12
        s.owner[8] = 2
        s.settlement[8] = 2
        s.specialty[8] = specialty.downcast_unchecked()
        let attack = Action { kind: 1, from: 7, to: 8, amount: 11 }
        assert(is_legal(s, attack))
        s = apply(s, attack)
        assert(s.owner[8] == 1 && s.specialty[8] == specialty.downcast_unchecked())
        assert(s.settlement[8] == 2 && supply(s, 1)[8])
        let active = economy(s, 1)
        s.owner[7] = 2
        assert(!supply(s, 1)[8])
        let cut = economy(s, 1)
        assert(cut.food_production == active.food_production - if specialty == 1 { 2 } else { 0 })
        assert(cut.gold_income == active.gold_income - 2)
        let recruit = Action { kind: 5, from: 8, to: 8, amount: 1 }
        assert(!is_legal(s, recruit))
        s.owner[7] = 1
        assert(economy(s, 1).food_production == active.food_production)
        assert(s.specialty[8] == specialty.downcast_unchecked())
        check_bounds(s)
    }
}
fn hungry_town_position() -> State {
    var s = initial(0)
    for i in 0 .. tile_count(s) {
        if passable(s, i) && i % map_width(s) < map_width(s) / 2 {
            s.owner[i] = 1
            s.troops[i] = 12
            s.siege[i] = 3
            s.fort[i] = 2
        }
    }
    s.settlement[5] = 2
    s.settlement[1] = 1
    s.settlement[11] = 1
    s.owner[7] = 2
    s.owner[8] = 2
    s.troops[7] = 12
    s.fort[7] = 2
    s.gold[1] = 6
    s.food[1] = 2
    // One remaining order cannot move these heavy detachments. This fixture
    // compares an affordable food investment with real alternatives, not a
    // sacrificial attack that would also reduce both threat and upkeep.
    s.orders = 1
    s
}
#[test]
fn both_policies_build_granary_for_sustained_food_support() {
    let s = hungry_town_position()
    assert(economy(s, 1).shortage > 2)
    let granary = Action { kind: 11, from: 5, to: 5, amount: 1 }
    let arsenal = Action { kind: 11, from: 5, to: 5, amount: 2 }
    assert(is_legal(s, granary) && is_legal(s, arsenal))
    assert(evaluate(apply(s, granary), 1) > evaluate(apply(s, arsenal), 1))
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(same_action(action, granary))
        assert(economy(apply(s, action), 1).food_production == economy(s, 1).food_production + 2)
    }
    // Construction consumes two food, so its first extra harvest merely pays
    // that back. Only the following harvest reduces this fixture's losses.
    var ordinary = apply(s, pass())
    var improved = apply(s, granary)
    ordinary.side = 1
    improved.side = 1
    ordinary = begin_turn(ordinary)
    improved = begin_turn(improved)
    assert(total_army(ordinary, 1) == total_army(improved, 1))
    ordinary = begin_turn(ordinary)
    improved = begin_turn(improved)
    assert(total_army(improved, 1) == total_army(ordinary, 1) + 2)
}
#[test]
fn specialty_value_depends_on_supply_and_legal_trace_replays() {
    var s = initial(0)
    s.settlement[5] = 2
    let base = evaluate(s, 1)
    s.specialty[5] = 2
    assert(evaluate(s, 1) > base)
    s.owner[0] = 2
    let disconnected = evaluate(s, 1)
    s.specialty[5] = 0
    assert(evaluate(s, 1) == disconnected)
    // A fully legal initial-state trace: upgrade, end both turns, fortify,
    // end both turns again, then specialize. No state edit is part of replay.
    let trace = [Action { kind: 4, from: 5, to: 5, amount: 2 }, pass(), pass(),
        Action { kind: 3, from: 5, to: 5, amount: 1 }, pass(), pass(),
        Action { kind: 11, from: 5, to: 5, amount: 2 }]
    s = initial(0)
    var replay = initial(0)
    for i in 0 .. 7 {
        assert(is_legal(s, trace[i]))
        s = apply(s, trace[i])
        replay = apply(replay, trace[i])
        assert(same_campaign(s, replay))
        check_bounds(s)
    }
    assert(s.specialty[5] == 2 && s.result == 0)
}

// V7 BOUNDED SHARED CROSSINGS
#[test]
fn designated_crossings_are_symmetric_paid_empty_and_shared() {
    for scenario in 0 .. 3 {
        for side in 1 .. 3 {
            var s = initial(scenario)
            let last = tile_count(s) - 1
            let top = map_width(s) / 2
            let site = if side == 1 { top } else { last - top }
            let bank = if side == 1 { top - 1 } else { last - top + 1 }
            s.side = side.downcast_unchecked()
            for q in 0 .. top {
                let tile = if side == 1 { q } else { last - q }
                s.owner[tile] = s.side
            }
            assert(crossing_bit(s, top) == 1 && crossing_bit(s, last - top) == 2)
            assert(terrain(s, site) == 8 && !passable(s, site) && !constructed_bridge(s, site))
            let action = Action { kind: 12, from: bank, to: site, amount: 1 }
            assert(is_legal(s, action) && order_cost(s, action) == 1)
            let before_army = total_army(s, s.side)
            let before_supply = supply_count(s, s.side)
            s = apply(s, action)
            assert(s.bridge_mask == if side == 1 { 1 } else { 2 })
            assert(constructed_bridge(s, site) && passable(s, site) && terrain(s, site) == 9)
            assert(s.owner[site] == 0 && s.troops[site] == 0 && defense(s, site) == 0)
            assert(s.gold[side] == 2 && s.food[side] == 10 && s.orders == 1)
            assert(total_army(s, s.side) == before_army)
            assert(supply_count(s, s.side).connected == before_supply.connected)
            assert(supply_count(s, s.side).cut_off == before_supply.cut_off)
            assert(!supply(s, s.side)[site] && !is_legal(s, action))
            s.troops[bank] = 4
            let occupy = Action { kind: 1, from: bank, to: site, amount: 3 }
            assert(is_legal(s, occupy))
            let occupied = apply(s, occupy)
            assert(occupied.owner[site] == side.downcast_unchecked() && occupied.troops[site] == 3)
            assert(occupied.troops[bank] == 1 && occupied.bridge_mask == s.bridge_mask)
            assert(supply(occupied, side.downcast_unchecked())[site])
            check_bounds(occupied)
        }
    }
    // The opposing kingdom may occupy a bridge the builder has left neutral.
    var s = apply(initial(0), Action { kind: 12, from: 1, to: 2, amount: 1 })
    s.side = 2
    s.orders = 2
    s.owner[3] = 2
    s.troops[3] = 5
    let enemy_occupation = Action { kind: 1, from: 3, to: 2, amount: 4 }
    assert(is_legal(s, enemy_occupation))
    s = apply(s, enemy_occupation)
    assert(s.owner[2] == 2 && s.troops[2] == 4 && s.troops[3] == 1)
    assert(s.bridge_mask == 1 && terrain(s, 2) == 9)
    check_bounds(s)
}
#[test]
fn crossing_construction_requires_resources_supply_land_and_designation() {
    var s = initial(0)
    let action = Action { kind: 12, from: 1, to: 2, amount: 1 }
    assert(is_legal(s, action))
    s.gold[1] = 5
    assert(!is_legal(s, action))
    s.gold[1] = 6
    s.food[1] = 1
    assert(!is_legal(s, action))
    s.food[1] = 2
    s.owner[0] = 2
    assert(!is_legal(s, action))
    s.owner[0] = 1
    assert(!is_legal(s, Action { kind: 12, from: 0, to: 2, amount: 1 }))
    assert(!is_legal(s, Action { kind: 12, from: 1, to: 2, amount: 2 }))
    assert(!is_legal(s, Action { kind: 12, from: 1, to: 6, amount: 1 }))
    s.owner[6] = 1
    s.owner[7] = 1
    assert(supply(s, 1)[7] && adjacent(s, 7, 2))
    assert(!is_legal(s, Action { kind: 12, from: 7, to: 2, amount: 1 }))
    s = initial(1)
    s.owner[1] = 1
    s.owner[8] = 1
    s.owner[9] = 1
    assert(terrain(s, 16) == 8 && crossing_bit(s, 16) == 0)
    assert(!is_legal(s, Action { kind: 12, from: 9, to: 16, amount: 1 }))
}
#[test]
fn all_four_navigation_variants_match_current_topology_oracle() {
    for scenario in 0 .. 3 {
        let base = initial(scenario)
        // This cache is constructed once at mask zero and reused for all
        // hypothetical masks, exactly as it is inside one policy search.
        let routes = navigation(base)
        for mask in 0 .. 4 {
            var s = base
            s.bridge_mask = mask
            var bridges: usize = 0
            var sites: usize = 0
            for i in 0 .. tile_count(s) {
                if crossing_bit(s, i) > 0 { sites += 1 }
                if terrain(s, i) == 9 { bridges += 1 }
                if passable(s, i) {
                    assert(routes.blue[mask][i] == shortest_route(s, capital(s, 1), i))
                    assert(routes.red[mask][i] == shortest_route(s, capital(s, 2), i))
                    assert(routes.blue[mask][i] < 1000 && routes.red[mask][i] < 1000)
                } else { assert(routes.blue[mask][i] == 1000 && routes.red[mask][i] == 1000) }
            }
            assert(sites == 2)
            assert(bridges == (if scenario == 0 { 1 } else { 2 }) + mask % 2 + mask / 2)
            for root in 1 .. 3 {
                let side: i64 = root.downcast_unchecked()
                let cached = with (Navigation = routes) { evaluate_cached(s, side) }
                assert(cached == evaluate(s, side))
            }
            let mirrored_mask = (mask % 2) * 2 + mask / 2
            var mirrored = base
            mirrored.bridge_mask = mirrored_mask
            for i in 0 .. tile_count(s) {
                assert(terrain(s, i) == terrain(mirrored, tile_count(s) - 1 - i))
            }
            check_bounds(s)
        }
        var built = base
        built.bridge_mask = 3
        let top = map_width(base) / 2
        assert(travel_distance(built, top - 1, top + 1) == 2)
        assert(travel_distance(base, top - 1, top + 1) > 2)
    }
}
fn crossing_reconnection_position() -> State {
    var s = initial(0)
    s.troops[0] = 1
    s.fort[0] = 2
    s.fort[1] = 2
    s.fort[5] = 2
    s.owner[3] = 1
    s.troops[3] = 12
    s.fort[3] = 2
    s.settlement[3] = 2
    s.specialty[3] = 1
    s.gold[1] = 6
    s.food[1] = 2
    s
}
#[test]
fn hypothetical_construction_uses_new_routes_and_occupation_restores_supply() {
    let s = crossing_reconnection_position()
    let build = Action { kind: 12, from: 1, to: 2, amount: 1 }
    assert(is_legal(s, build) && supply_count(s, 1).cut_off == 1)
    let routes = navigation(s)
    let built = apply(s, build)
    assert(!supply(built, 1)[3] && !supply(built, 1)[2])
    for root in 1 .. 3 {
        let side: i64 = root.downcast_unchecked()
        assert(with (Navigation = routes) { evaluate_cached(built, side) } == evaluate(built, side))
    }
    // Independent sensitivity guard: only the active mask may influence this
    // asymmetric position. An always-mask-zero cache would fail both checks.
    let ordinary_score = evaluate(built, 1)
    var active_routes = navigation(s)
    active_routes.red[built.bridge_mask][3] += 1
    let active_score = with (Navigation = active_routes) { evaluate_cached(built, 1) }
    assert(active_score == ordinary_score - built.troops[3])
    var inactive_routes = navigation(s)
    inactive_routes.red[0][3] += 1
    assert(with (Navigation = inactive_routes) { evaluate_cached(built, 1) } == ordinary_score)
    var cached_stats = Search { nodes: 0 }
    var fresh_stats = Search { nodes: 0 }
    let cached_search = with (Navigation = routes, Search = cached_stats) { search_cached(built, 2, 1, -200000, 200000) }
    let fresh_search = with (Search = fresh_stats) { search(built, 2, 1, -200000, 200000) }
    assert(cached_search == fresh_search && cached_stats.nodes == fresh_stats.nodes)
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let action = with (Search = stats) { choose(built, difficulty.downcast_unchecked()) }
        assert(is_legal(built, action) && action.kind == 1 && action.to == 2)
        let connected = apply(built, action)
        assert(supply(connected, 1)[3] && supply_count(connected, 1).cut_off == 0)
        assert(connected.troops[action.from] + connected.troops[2] == built.troops[action.from])
        assert(connected.specialty[3] == 1)
        check_bounds(connected)
    }
    // Construction itself is an investment, not immediate supply. Hard may
    // instead reconnect through the existing bridge while capturing useful
    // land. Test the strategic outcome, not compulsory new infrastructure.
    var hard = Search { nodes: 0 }
    let planned = with (Search = hard) { choose(s, 1) }
    assert(is_legal(s, planned))
    assert(hard.nodes > 0 && hard.nodes <= 2590)
    var developed = apply(s, planned)
    if developed.side == s.side {
        let next = with (Search = hard) { choose(developed, 1) }
        assert(is_legal(developed, next))
        developed = apply(developed, next)
    }
    assert(supply(developed, 1)[3] && supply_count(developed, 1).cut_off == 0)
    var easy = Search { nodes: 0 }
    assert(is_legal(s, with (Search = easy) { choose(s, 0) }))
}
#[test]
fn both_shared_crossings_replay_without_troop_or_resource_gifts() {
    let trace = [Action { kind: 12, from: 1, to: 2, amount: 1 },
        Action { kind: 1, from: 1, to: 2, amount: 2 },
        Action { kind: 12, from: 13, to: 12, amount: 1 },
        Action { kind: 1, from: 13, to: 12, amount: 2 }]
    var s = initial(0)
    var replay = initial(0)
    let blue_army = total_army(s, 1)
    let red_army = total_army(s, 2)
    for i in 0 .. 4 {
        assert(is_legal(s, trace[i]))
        s = apply(s, trace[i])
        replay = apply(replay, trace[i])
        assert(same_campaign(s, replay))
        assert(total_army(s, 1) == blue_army && total_army(s, 2) == red_army)
        check_bounds(s)
    }
    assert(s.bridge_mask == 3 && s.owner[2] == 1 && s.owner[12] == 2)
    assert(s.troops[2] == 2 && s.troops[12] == 2)
    assert(s.gold[1] == 5 && s.gold[2] == 5)
}
#[test]
fn hard_can_decline_a_crossing_exposed_to_a_strong_enemy() {
    var s = crossing_reconnection_position()
    s.owner[7] = 2
    s.troops[7] = 12
    s.fort[7] = 2
    var stats = Search { nodes: 0 }
    let action = with (Search = stats) { choose(s, 1) }
    let build = Action { kind: 12, from: 1, to: 2, amount: 1 }
    assert(is_legal(s, action) && is_legal(s, build) && !same_action(action, build))
    // The fortified army can contest the new adjacent bridge. Evaluate both
    // candidate lines at the policy's real horizon rather than force a build.
    let focus = select_focus(s, 1)
    let routes = navigation(s)
    let chosen_value = with (Navigation = routes, Search = stats) { search_focused_cached(apply(s, action), 3, 1, -200000, 200000, focus) }
    let build_value = with (Navigation = routes, Search = stats) { search_focused_cached(apply(s, build), 3, 1, -200000, 200000, focus) }
    assert(chosen_value > build_value)
    check_bounds(apply(s, action))
}

// V7 TRUTHFUL BOUNDED POLICY FOCUS AND DECISION REPORTS
#[test]
fn additive_evaluation_keeps_normal_material_resources_and_supply_weights() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        let routes = navigation(s)
        let focus = Focus { kind: 4, target: capital(s, 2) }
        let before = with (Navigation = routes) { breakdown_cached(s, 1, focus) }
        for component in 0 .. 8 { assert(before.parts[component] == 0) }
        var changed = s
        changed.gold[1] += 1
        changed.food[1] += 1
        let resources = with (Navigation = routes) { breakdown_cached(changed, 1, focus) }
        assert(resources.parts[1] == 4 && evaluation_total(resources) == 4)
        changed = s
        changed.troops[0] += 1
        let material = with (Navigation = routes) { breakdown_cached(changed, 1, focus) }
        assert(material.parts[0] == 12 && evaluation_total(material) == 12)
        changed = s
        changed.fort[0] += 1
        let fort = with (Navigation = routes) { breakdown_cached(changed, 1, focus) }
        assert(fort.parts[0] == 4 && evaluation_total(fort) == 4)
    }
    var s = initial(0)
    s.owner[6] = 1
    let routes = navigation(s)
    let captured = with (Navigation = routes) { breakdown_cached(s, 1, Focus { kind: 4, target: 14 }) }
    assert(captured.parts[0] == 40 && captured.parts[2] == 28)
    assert(evaluation_total(captured) == 68 && captured.parts[6] == 0)
}
#[test]
fn focus_priority_is_observable_and_targets_a_specific_holding() {
    var s = initial(0)
    assert(select_focus(s, 1).kind == 4 && select_focus(s, 1).target == 14)
    s.owner[3] = 1
    s.troops[3] = 2
    s.owner[8] = 1
    s.troops[8] = 12
    assert(select_focus(s, 1).kind == 2 && select_focus(s, 1).target == 8)
    s.owner[1] = 2
    s.troops[1] = 10
    assert(direct_capital_threats(s, 1) == 1)
    assert(select_focus(s, 1).kind == 1 && select_focus(s, 1).target == 0)
    s = hungry_town_position()
    assert(select_focus(s, 1).kind == 3 && select_focus(s, 1).target == MAX_TILES)
    s.owner[8] = 1
    assert(select_focus(s, 1).kind == 2 && select_focus(s, 1).target == 8)
}
#[test]
fn focused_capital_defense_and_food_are_real_scoring_terms() {
    var s = initial(0)
    s.owner[1] = 2
    s.troops[1] = 9
    s.gold[1] = 2
    let focus = select_focus(s, 1)
    let routes = navigation(s)
    let fortify = Action { kind: 3, from: 0, to: 0, amount: 1 }
    assert(is_legal(s, fortify) && focus.kind == 1)
    let before = with (Navigation = routes) { breakdown_cached(s, 1, focus) }
    let defended = apply(s, fortify)
    let after = with (Navigation = routes) { breakdown_cached(defended, 1, focus) }
    assert(before.parts[6] == -36 && after.parts[6] == 16)
    assert(direct_capital_threats(defended, 1) == 0)
    assert(evaluation_total(after) - evaluation_total(before) == evaluate(defended, 1) - evaluate(s, 1) + 52)
    let unrelated = apply(s, Action { kind: 3, from: 5, to: 5, amount: 1 })
    let unrelated_parts = with (Navigation = routes) { breakdown_cached(unrelated, 1, focus) }
    assert(evaluate(defended, 1) > evaluate(unrelated, 1))
    assert(evaluation_total(after) - evaluation_total(unrelated_parts) == evaluate(defended, 1) - evaluate(unrelated, 1) + 52)
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let decision = with (Search = stats) { decide(s, difficulty.downcast_unchecked()) }
        // Ending the turn can also be sound here: this cut-off enemy loses a
        // troop before it can act. Require actual protection, not one order.
        assert(is_legal(s, decision.action))
        let protected = apply(s, decision.action)
        assert(protected.owner[0] == 1 && protected.result == 0 && direct_capital_threats(protected, 1) == 0)
        assert(decision.focus.kind == 1 && decision.focus.target == 0)
    }
    s = hungry_town_position()
    let food_focus = select_focus(s, 1)
    let granary = apply(s, Action { kind: 11, from: 5, to: 5, amount: 1 })
    let arsenal = apply(s, Action { kind: 11, from: 5, to: 5, amount: 2 })
    let food_routes = navigation(s)
    let granary_parts = with (Navigation = food_routes) { breakdown_cached(granary, 1, food_focus) }
    let arsenal_parts = with (Navigation = food_routes) { breakdown_cached(arsenal, 1, food_focus) }
    assert(food_focus.kind == 3)
    assert(granary_parts.parts[6] - arsenal_parts.parts[6] == 26)
    assert(evaluation_total(granary_parts) - evaluation_total(arsenal_parts) == evaluate(granary, 1) - evaluate(arsenal, 1) + 26)
}
#[test]
fn root_focus_remains_frozen_when_the_action_completes_its_objective() {
    let s = apply(crossing_reconnection_position(), Action { kind: 12, from: 1, to: 2, amount: 1 })
    let focus = select_focus(s, 1)
    assert(focus.kind == 2 && focus.target == 3)
    var stats = Search { nodes: 0 }
    let decision = with (Search = stats) { decide(s, 0) }
    let after = apply(s, decision.action)
    assert(supply(after, 1)[3] && select_focus(after, 1).kind != 2)
    assert(decision.focus.kind == 2 && decision.focus.target == 3 && decision.deltas[6] == 40)
    let routes = navigation(s)
    let frozen = with (Navigation = routes) { breakdown_cached(after, 1, focus) }
    let changed = with (Navigation = routes) { breakdown_cached(after, 1, select_focus(after, 1)) }
    assert(decision.after_score == evaluation_total(frozen))
    assert(evaluation_total(frozen) == evaluation_total(changed) + 40)
}
#[test]
fn decision_reports_match_actual_actions_components_and_searched_values() {
    for scenario in 0 .. 3 {
        for difficulty in 0 .. 2 {
            let s = initial(scenario)
            var stats = Search { nodes: 17 }
            let report = with (Search = stats) { decide(s, difficulty.downcast_unchecked()) }
            assert(is_legal(s, report.action) && report.side == s.side)
            assert(report.depth == if difficulty == 0 { 1 } else { 4 })
            assert(report.nodes > 0 && report.nodes == stats.nodes - 17)
            assert(report.order_cost == order_cost(s, report.action))
            let routes = navigation(s)
            let before = with (Navigation = routes) { breakdown_cached(s, s.side, report.focus) }
            let after = with (Navigation = routes) { breakdown_cached(apply(s, report.action), s.side, report.focus) }
            assert(report.before_score == evaluation_total(before) && report.after_score == evaluation_total(after))
            var total_delta: i64 = 0
            var largest: i64 = 0
            var expected_highlight: i64 = 0
            for component in 0 .. 8 {
                assert(report.deltas[component] == after.parts[component] - before.parts[component])
                total_delta += report.deltas[component]
                if report.deltas[component] > largest {
                    largest = report.deltas[component]
                    expected_highlight = (component + 1).downcast_unchecked()
                }
            }
            assert(total_delta == report.after_score - report.before_score && report.highlight == expected_highlight)
            var repeated_stats = Search { nodes: 0 }
            let repeat = with (Search = repeated_stats) { decide(s, difficulty.downcast_unchecked()) }
            assert(same_action(report.action, repeat.action) && report.nodes == repeat.nodes)
            assert(report.search_score == repeat.search_score && report.after_score == repeat.after_score)
            if difficulty == 0 {
                assert(report.search_score == report.after_score && report.nodes == legal(s).len.downcast_unchecked())
            } else {
                assert(report.nodes <= 2590)
                var oracle = Search { nodes: 0 }
                let horizon = with (Navigation = routes, Search = oracle) {
                    search_focused_cached(apply(s, report.action), 3, s.side, -200000, 200000, report.focus)
                }
                assert(report.search_score == horizon)
            }
        }
    }
}
#[test]
fn terminal_scores_dominate_every_focus_and_highlights_handle_tradeoffs() {
    var s = initial(0)
    s.owner[13] = 1
    s.troops[13] = 12
    s.siege[13] = 2
    s.troops[14] = 12
    s.fort[14] = 2
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let report = with (Search = stats) { decide(s, difficulty.downcast_unchecked()) }
        let won = apply(s, report.action)
        assert(won.result == 1 && report.after_score == 100000 - won.turn && report.highlight == 8)
    }
    for focus_kind in 1 .. 5 {
        let focus = Focus { kind: focus_kind.downcast_unchecked(), target: if focus_kind == 3 { MAX_TILES } else { 0 } }
        let routes = navigation(s)
        for result in 1 .. 4 {
            var terminal = s
            terminal.result = result.downcast_unchecked()
            let scored = with (Navigation = routes) { breakdown_cached(terminal, 1, focus) }
            for component in 0 .. 7 { assert(scored.parts[component] == 0) }
            assert(scored.parts[7] == if result == 1 { 100000 - s.turn } else if result == 2 { -100000 + s.turn } else { 0 })
        }
    }
    assert(positive_highlight([-1, -2, 0, -3, 0, 0, -4, 0]) == 0)
    assert(positive_highlight([5, 5, 0, 0, 0, 0, 0, 0]) == 1)
    // A positive component does not imply that the immediate total improved.
    assert(positive_highlight([10, -20, 0, 0, 0, 0, 0, 0]) == 1)
    assert(positive_highlight([10, 0, 0, 0, 0, 0, 0, 100000]) == 8)
}
#[test]
fn automatic_decision_history_retains_only_the_last_two_actual_actions() {
    var s = initial(0)
    var history = empty_decision_history()
    assert(history.len == 0)
    var previous = empty_decision()
    var stats = Search { nodes: 0 }
    for step in 0 .. 6 {
        let report = with (Search = stats) { decide(s, 0) }
        with (DecisionHistory = history) { remember_decision(report, step) }
        assert(history.len == if step == 0 { 1 } else { 2 })
        let last = history.len - 1
        assert(history.trace_indices[last] == step && same_action(history.items[last].action, report.action))
        assert(history.items[last].nodes == report.nodes && history.items[last].search_score == report.search_score)
        if step > 0 {
            assert(history.trace_indices[0] == step - 1)
            assert(same_action(history.items[0].action, previous.action))
        }
        previous = report
        s = apply(s, report.action)
        assert(s.result == 0 && !s.decision_pending)
    }
}
#[test]
fn infantry_capture_can_fortify_but_two_order_assaults_cannot() {
    var s = initial(0)
    s.troops[5] = 6
    let assault = Action { kind: 1, from: 5, to: 6, amount: 5 }
    let fortify = Action { kind: 3, from: 6, to: 6, amount: 1 }
    assert(is_legal(s, assault) && order_cost(s, assault) == 1)
    let captured = apply(s, assault)
    assert(captured.owner[6] == 1 && captured.side == 1 && captured.orders == 1 && supply(captured, 1)[6])
    assert(is_legal(captured, fortify))
    let fortified = apply(captured, fortify)
    assert(fortified.fort[6] == 1 && fortified.gold[1] == s.gold[1] - 2)
    assert(fortified.side == 2 && fortified.food[1] == s.food[1])
    assert(defense(fortified, 6) == fortified.troops[6] + 2)
    let routes = navigation(s)
    let focus = select_focus(s, 1)
    let candidates = with (Navigation = routes) { ranked_focused(captured, 1, focus) }
    var found = false
    for i in 0 .. candidates.len { if same_action(candidates.items[i], fortify) { found = true } }
    assert(found)
    var stats = Search { nodes: 0 }
    let searched = with (Navigation = routes, Search = stats) { search_focused_cached(captured, 1, 1, -200000, 200000, focus) }
    let fort_value = with (Navigation = routes) { evaluation_total(breakdown_cached(fortified, 1, focus)) }
    assert(searched >= fort_value)
    for role in 1 .. 3 {
        var heavy = s
        if role == 1 { heavy.cavalry[5] = 1 } else { heavy.siege[5] = 1 }
        assert(is_legal(heavy, assault) && order_cost(heavy, assault) == 2)
        heavy = apply(heavy, assault)
        assert(heavy.owner[6] == 1 && heavy.side == 2 && !is_legal(heavy, fortify))
        check_bounds(heavy)
    }
    var poor = s
    poor.gold[1] = 1
    poor = apply(poor, assault)
    assert(poor.side == 1 && !is_legal(poor, fortify))
    var isolated = initial(0)
    isolated.owner[7] = 1
    isolated.troops[7] = 6
    isolated = apply(isolated, Action { kind: 1, from: 7, to: 8, amount: 5 })
    assert(isolated.side == 1 && isolated.owner[8] == 1 && !supply(isolated, 1)[8])
    assert(!is_legal(isolated, Action { kind: 3, from: 8, to: 8, amount: 1 }))
}

fn research(_ town: usize, _ id: i64) -> Action { Action { kind: 13, from: town, to: town, amount: id } }
#[test]
fn research_requires_canonical_supplied_town_prerequisite_and_exact_payment() {
    var s = initial(0)
    assert(!is_legal(s, research(5, 1)))
    s.settlement[5] = 2
    s.specialty[5] = 1
    s.gold[1] = 12
    s.food[1] = 2
    assert(is_legal(s, research(5, 1)) && !is_legal(s, research(5, 2)))
    assert(!is_legal(s, research(5, 0)) && !is_legal(s, research(5, 4)))
    assert(!is_legal(s, Action { kind: 13, from: 5, to: 1, amount: 1 }))
    var poor = s
    poor.gold[1] = 5
    assert(!is_legal(poor, research(5, 1)))
    var lost = s
    lost.owner[0] = 2
    assert(!is_legal(lost, research(5, 1)))
    s = apply(s, research(5, 1))
    assert(s.gold[1] == 6 && s.food[1] == 2 && s.orders == 1 && s.side == 1)
    assert(s.developments[1] == 1 && s.developments[2] == 0)
    assert(!is_legal(s, research(5, 1)) && is_legal(s, research(5, 2)))
    poor = s
    poor.food[1] = 1
    assert(!is_legal(poor, research(5, 2)))
    poor = s
    poor.gold[1] = 5
    assert(!is_legal(poor, research(5, 2)))
    let after = apply(s, research(5, 2))
    assert(after.gold[1] == 0 && after.food[1] == 0 && after.side == 2 && after.orders == 2)
    assert(after.developments[1] == 3 && after.developments[2] == 0)
    assert(same_army(army_at(after, 5), army_at(s, 5)))
    s.side = 1
    s.orders = 2
    s.gold[1] = 40
    s.food[1] = 40
    s.settlement[1] = 2
    assert(development_town(s, 1, 1, supply(s, 1)) == 1)
    assert(development_town(s, 1, 2, supply(s, 1)) == 5)
    assert(!is_legal(s, research(1, 2)))
    s.specialty[1] = 1
    assert(is_legal(s, research(1, 2)) && !is_legal(s, research(5, 2)))
    s.decision_pending = true
    assert(!is_legal(s, research(1, 2)))
    s.decision_pending = false
    s.result = 1
    assert(!is_legal(s, research(1, 2)))
}
#[test]
fn charter_and_rotation_suspend_resume_and_use_capped_real_economy() {
    var s = initial(2)
    // Owned region includes three farms; rotation is capped at two, not three.
    for i in 0 .. tile_count(s) { if passable(s, i) { s.owner[i] = 1
        s.troops[i] = 1 } }
    s.owner[capital(s, 2)] = 2
    s.settlement[9] = 2
    s.specialty[9] = 1
    let base = economy(s, 1)
    s.developments[1] = 3
    let improved = economy(s, 1)
    assert(improved.gold_income == base.gold_income + 1)
    assert(improved.food_production == base.food_production + 2)
    s.settlement[1] = 2
    assert(economy(s, 1).gold_income == improved.gold_income + 2)
    s.food[1] = 40
    s.gold[1] = 40
    s.troops[0] = 7
    let started = begin_turn(s)
    assert(started.gold[1] == 40 && started.food[1] == 38)
    // Losing operational granary removes only its own output and rotation bonus.
    s.specialty[9] = 0
    assert(active_developments(s, 1, supply(s, 1)) == 1)
    let inactive = economy(s, 1)
    s.specialty[9] = 1
    assert(economy(s, 1).food_production == inactive.food_production + 4)
    assert(active_developments(s, 1, supply(s, 1)) == 3)
    // Synthetic capital disconnection exercises the shared supply gate.
    s.owner[0] = 2
    assert(active_developments(s, 1, supply(s, 1)) == 0 && s.developments[1] == 3)
    assert(economy(s, 1).gold_income == 2 && economy(s, 1).food_production == 3)
    s.owner[0] = 1
    assert(active_developments(s, 1, supply(s, 1)) == 3)
    // No supplied farm means no rotation output, even with operational knowledge.
    for i in 0 .. tile_count(s) { if terrain(s, i) == 1 { s.owner[i] = 0 } }
    let no_farms = economy(s, 1).food_production
    s.developments[1] = 1
    assert(economy(s, 1).food_production == no_farms)
}
#[test]
fn muster_discount_is_local_paid_infantry_only_and_respects_caps() {
    var s = initial(0)
    s.settlement[5] = 2
    s.specialty[5] = 2
    s.developments[1] = 1
    s.gold[1] = 8
    s.food[1] = 4
    assert(is_legal(s, research(5, 3)))
    s = apply(s, research(5, 3))
    assert(s.developments[1] == 5 && s.gold[1] == 2 && s.food[1] == 2)
    let recruit = Action { kind: 2, from: 5, to: 5, amount: 2 }
    assert(is_legal(s, recruit))
    assert(recruitment_gold(s, 5, 0, true) == 2 && recruitment_gold(s, 0, 0, true) == 3)
    assert(recruitment_gold(s, 5, 1, true) == 3 && recruitment_gold(s, 5, 2, true) == 4)
    let after = apply(s, recruit)
    assert(after.gold[1] == 0 && after.food[1] == 0 && after.troops[5] == s.troops[5] + 2)
    assert(after.side == 2 && after.orders == 2)
    s.troops[5] = 11
    assert(!is_legal(s, recruit))
    s.troops[5] = 10
    assert(is_legal(s, recruit))
    s.food[1] = 1
    assert(!is_legal(s, recruit))
    s.food[1] = 2
    s.gold[1] = 1
    assert(!is_legal(s, recruit))
    s.gold[1] = 2
    s.specialty[5] = 1
    assert(!is_legal(s, recruit) && recruitment_gold(s, 5, 0, true) == 3)
    s.specialty[5] = 2
    s.owner[0] = 2
    assert(!is_legal(s, recruit) && recruitment_gold(s, 5, 0, false) == 3)
}
#[test]
fn capturing_research_town_keeps_knowledge_with_original_kingdom() {
    var s = initial(0)
    s.settlement[5] = 2
    s.specialty[5] = 2
    s.developments[1] = 5
    s.owner[6] = 2
    s.troops[6] = 8
    s.side = 2
    let attack = Action { kind: 1, from: 6, to: 5, amount: 7 }
    assert(is_legal(s, attack))
    let after = apply(s, attack)
    assert(after.owner[5] == 2 && after.specialty[5] == 2)
    assert(after.developments[1] == 5 && after.developments[2] == 0)
    assert(active_developments(after, 1, supply(after, 1)) == 0)
    assert(recruitment_gold(after, 5, 0, true) == 3)
}
#[test]
fn development_graph_replays_from_initial_with_no_knowledge_in_save() {
    var s = initial(0)
    let actions = [
        Action { kind: 4, from: 5, to: 5, amount: 2 }, pass(), pass(),
        Action { kind: 3, from: 0, to: 0, amount: 1 }, pass(), pass(),
        research(5, 1), pass(), pass(),
        Action { kind: 3, from: 1, to: 1, amount: 1 }, pass(), pass(),
        Action { kind: 11, from: 5, to: 5, amount: 2 }, pass(), pass(),
        research(5, 3), pass(), pass(),
    ]
    for i in 0 .. 18 { assert(is_legal(s, actions[i]))
        s = apply(s, actions[i])
        check_bounds(s) }
    assert(s.developments[1] == 5 && s.developments[2] == 0)
    var replay = initial(0)
    for i in 0 .. 18 { replay = apply(replay, actions[i]) }
    assert(same_campaign(s, replay))
}
#[test]
fn every_development_mask_is_bounded_and_investment_is_explicit() {
    for mask in 0 .. 8 {
        var s = initial(0)
        s.settlement[5] = 2
        s.specialty[5] = 2
        s.gold[1] = 40
        s.food[1] = 40
        s.developments[1] = mask
        s.developments[2] = mask
        let choices = legal(s)
        assert(choices.len < MAX_ACTIONS)
        var research_count: usize = 0
        for i in 0 .. choices.len {
            let action = choices.items[i]
            if action.kind == 13 { research_count += 1 }
            let after = apply(s, action)
            check_bounds(after)
            assert(after.developments[1] <= 7 && after.developments[2] == mask)
        }
        assert(research_count <= 2)
    }
    var s = initial(0)
    s.settlement[5] = 2
    let before = evaluate(s, 1)
    let after = apply(s, research(5, 1))
    // A's exact -12 purchase penalty is preserved in the liquid-resource term.
    // B adds only the documented finite-horizon operational estimate.
    let estimate = investment_estimate(after, 1, supply(after, 1), economy(after, 1))
    assert(evaluate(after, 1) == before - 12 + estimate.value)
}
#[test]
fn research_never_displaces_immediate_capital_wins_or_needed_defense() {
    for difficulty in 0 .. 2 {
        var s = initial(0)
        s.settlement[5] = 2
        s.gold[1] = 12
        s.owner[13] = 1
        s.troops[13] = 10
        assert(is_legal(s, research(5, 1)))
        var stats = Search { nodes: 0 }
        let win = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(apply(s, win).result == 1)
        s = initial(0)
        s.owner[1] = 2
        s.troops[1] = 9
        s.settlement[5] = 2
        s.gold[1] = 6
        assert(is_legal(s, research(5, 1)))
        let protect = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        let protected = apply(s, protect)
        assert(protect.kind != 13 && protected.owner[0] == 1 && direct_capital_threats(protected, 1) == 0)
    }
}
#[test]
fn both_kingdoms_research_and_dense_developed_boards_fit_action_capacity() {
    for scenario in 0 .. 3 {
        for side in 1 .. 3 {
            let player: i64 = side.downcast_unchecked()
            var s = initial(scenario)
            s.side = player
            let town = if side == 1 { map_width(s) } else { tile_count(s) - 1 - map_width(s) }
            s.settlement[town] = 2
            s.specialty[town] = 2
            s.gold[side] = 12
            s.food[side] = 2
            assert(is_legal(s, research(town, 1)))
            s = apply(s, research(town, 1))
            assert(is_legal(s, research(town, 3)))
            s = apply(s, research(town, 3))
            assert(s.developments[side] == 5 && s.gold[side] == 0 && s.food[side] == 0)
            s = initial(scenario)
            s.side = player
            s.gold[side] = 40
            s.food[side] = 40
            for i in 0 .. tile_count(s) {
                if passable(s, i) { s.owner[i] = player
                    s.troops[i] = 6
                    s.settlement[i] = 2 }
            }
            s.specialty[town] = 2
            s.developments[side] = 1
            let choices = legal(s)
            assert(choices.len > 0 && choices.len < MAX_ACTIONS)
            var count: usize = 0
            for i in 0 .. choices.len { if choices.items[i].kind == 13 { count += 1 } }
            assert(count == 1)
        }
    }
}

fn investment_frontier() -> State {
    var s = initial(2)
    s.settlement[1] = 2
    s.specialty[1] = 2
    s.owner[10] = 1
    s.troops[10] = 1
    s.owner[2] = 2
    s.troops[2] = 12
    s.owner[11] = 2
    s.troops[11] = 12
    s.gold[1] = 8
    s.food[1] = 40
    s
}
#[test]
fn investment_demand_is_finite_discovery_independent_and_requires_real_frontier() {
    var s = investment_frontier()
    let connected = supply(s, 1)
    let demand = investment_demand(s, 1, connected)
    assert(demand.town < MAX_TILES && demand.recruits > 0 && demand.recruits <= 12)
    for mask in 0 .. 8 {
        s.developments[1] = mask
        let same = investment_demand(s, 1, connected)
        assert(same.town == demand.town && same.recruits == demand.recruits)
    }
    s.owner[2] = 0
    s.owner[11] = 0
    assert(investment_demand(s, 1, supply(s, 1)).recruits == 0)
    s = investment_frontier()
    for i in 0 .. tile_count(s) { if s.owner[i] == 1 { s.troops[i] = 12 } }
    assert(investment_demand(s, 1, supply(s, 1)).recruits == 0)
    s = investment_frontier()
    s.owner[0] = 2
    assert(investment_demand(s, 1, supply(s, 1)).recruits == 0)
}
#[test]
fn investment_tracks_caps_supply_and_actual_resource_payback_not_ownership() {
    var s = initial(0)
    s.settlement[5] = 2
    s.developments[1] = 1
    s.gold[1] = 0
    let low = investment_estimate(s, 1, supply(s, 1), economy(s, 1))
    assert(low.value > 0 && low.value <= 18 && low.recruits == 0)
    s.gold[1] = 40
    let capped = investment_estimate(s, 1, supply(s, 1), economy(s, 1))
    assert(capped.value == 0 && capped.recruits == 0)
    s.owner[0] = 2
    assert(investment_estimate(s, 1, supply(s, 1), economy(s, 1)).value == 0)
    s = investment_frontier()
    s.developments[1] = 5
    let supported = investment_estimate(s, 1, supply(s, 1), economy(s, 1))
    assert(supported.recruits > 0 && supported.recruits <= 12 && supported.value > 0)
    s.food[1] = 0
    let poor = investment_estimate(s, 1, supply(s, 1), economy(s, 1))
    assert(poor.recruits < supported.recruits)
    s = initial(0)
    s.settlement[5] = 2
    s.specialty[5] = 2
    s.developments[1] = 4
    assert(investment_estimate(s, 1, supply(s, 1), economy(s, 1)).value == 0)
    // No option value for an unbuilt/inactive branch.
    s.developments[1] = 2
    assert(investment_estimate(s, 1, supply(s, 1), economy(s, 1)).value == 0)
}
#[test]
fn investment_replaces_rotation_food_net_and_preserves_component_sums() {
    var s = initial(0)
    s.settlement[5] = 2
    s.specialty[5] = 1
    s.food[1] = 40
    s.developments[1] = 1
    let routes = navigation(s)
    let connected = supply(s, 1)
    for kind in 3 .. 5 {
        let focus = Focus { kind: kind.downcast_unchecked(), target: MAX_TILES }
        let before = with (Navigation = routes) { breakdown_cached(s, 1, focus) }
        let old_estimate = investment_estimate(s, 1, connected, economy(s, 1))
        var changed = s
        changed.developments[1] = 3
        let after = with (Navigation = routes) { breakdown_cached(changed, 1, focus) }
        let new_estimate = investment_estimate(changed, 1, connected, economy(changed, 1))
        assert(new_estimate.rotation == 1)
        assert(evaluation_total(after) - evaluation_total(before) == new_estimate.value - old_estimate.value)
    }
    // Food focus rewards only root's food net. Enemy rotation must cancel five,
    // never eight, points per production unit under that same frozen focus.
    s.settlement[9] = 2
    s.specialty[9] = 1
    s.food[2] = 40
    s.developments[2] = 1
    let enemy_supply = supply(s, 2)
    let focus = Focus { kind: 3, target: MAX_TILES }
    let before_enemy = with (Navigation = routes) { breakdown_cached(s, 1, focus) }
    let old_enemy = investment_estimate(s, 2, enemy_supply, economy(s, 2))
    var enemy_changed = s
    enemy_changed.developments[2] = 3
    let after_enemy = with (Navigation = routes) { breakdown_cached(enemy_changed, 1, focus) }
    let new_enemy = investment_estimate(enemy_changed, 2, enemy_supply, economy(enemy_changed, 2))
    assert(new_enemy.rotation == 1)
    assert(evaluation_total(after_enemy) - evaluation_total(before_enemy) == old_enemy.value - new_enemy.value)
    s = investment_frontier()
    s.developments[1] = 5
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let decision = with (Search = stats) { decide(s, difficulty.downcast_unchecked()) }
        var delta: i64 = 0
        for i in 0 .. 8 { delta += decision.deltas[i] }
        assert(delta == decision.after_score - decision.before_score)
    }
}
#[test]
fn valuation_is_pure_for_every_legal_transition_and_supply_cut_remains_tactical() {
    var s = investment_frontier()
    s.developments[1] = 5
    let original = s
    let choices = legal(s)
    for i in 0 .. choices.len {
        let expected = apply(s, choices.items[i])
        let score = evaluate(expected, 1)
        let actual = apply(s, choices.items[i])
        assert(same_campaign(expected, actual) && same_campaign(s, original))
        assert(score == evaluate(actual, 1))
    }
    s = bridge_cut_position()
    s.settlement[0] = 2
    s.developments[1] = 1
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        let after = apply(s, action)
        assert(supply_count(after, 2).cut_off > supply_count(s, 2).cut_off)
    }
}

fn mirrored_investment_state(_ s: State) -> State {
    var mirrored = s
    let last = tile_count(s) - 1
    for i in 0 .. tile_count(s) {
        let target = last - i
        mirrored.owner[target] = if s.owner[i] == 0 { 0 } else { 3 - s.owner[i] }
        mirrored.troops[target] = s.troops[i]
        mirrored.cavalry[target] = s.cavalry[i]
        mirrored.siege[target] = s.siege[i]
        mirrored.fort[target] = s.fort[i]
        mirrored.settlement[target] = s.settlement[i]
        mirrored.specialty[target] = s.specialty[i]
    }
    for side in 1 .. 3 {
        mirrored.gold[3 - side] = s.gold[side]
        mirrored.food[3 - side] = s.food[side]
        mirrored.developments[3 - side] = s.developments[side]
    }
    mirrored.side = 3 - s.side
    if s.result == 1 || s.result == 2 { mirrored.result = 3 - s.result }
    mirrored.bridge_mask = (s.bridge_mask % 2) * 2 + s.bridge_mask / 2
    mirrored
}
#[test]
fn mirrored_investment_estimates_and_equal_demand_ties_match_both_seats() {
    var s = investment_frontier()
    // Towns 1 and 10 see the same recipients/enemies and both offer ten
    // recruit orders. Different specialties make a tie-direction error matter.
    s.settlement[9] = 0
    s.settlement[10] = 2
    s.specialty[10] = 1
    let first = investment_demand(s, 1, supply(s, 1))
    assert(first.town == 1 && first.recruits == 10)
    var without_first = s
    without_first.settlement[1] = 0
    without_first.specialty[1] = 0
    let second = investment_demand(without_first, 1, supply(without_first, 1))
    assert(second.town == 10 && second.recruits == first.recruits)
    s.gold[2] = 17
    s.food[2] = 21
    for mask in 0 .. 8 {
        s.developments[1] = mask
        s.developments[2] = 7 - mask
        for bridges in 0 .. 4 {
            s.bridge_mask = bridges
            let mirrored = mirrored_investment_state(s)
            assert(same_campaign(s, mirrored_investment_state(mirrored)))
            for side in 1 .. 3 {
                let player: i64 = side.downcast_unchecked()
                let own_supply = supply(s, player)
                let opposite_supply = supply(mirrored, 3 - player)
                let demand = investment_demand(s, player, own_supply)
                let opposite_demand = investment_demand(mirrored, 3 - player, opposite_supply)
                assert(demand.recruits == opposite_demand.recruits)
                assert(opposite_demand.town == if demand.town == MAX_TILES { MAX_TILES } else { tile_count(s) - 1 - demand.town })
                let estimate = investment_estimate(s, player, own_supply, economy(s, player))
                let opposite = investment_estimate(mirrored, 3 - player, opposite_supply, economy(mirrored, 3 - player))
                assert(estimate.value == opposite.value && estimate.rotation == opposite.rotation
                    && estimate.recruits == opposite.recruits)
            }
        }
    }
}
