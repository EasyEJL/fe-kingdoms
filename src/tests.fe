// Tests exercise Fe rules directly. Protocol/replay tests live in the host suite.
fn total_army(_ s: State, _ side: i64) -> i64 {
    var total: i64 = 0
    for i in 0 .. tile_count(s) { if s.owner[i] == side { total += s.troops[i] } }
    total
}
fn shortest_route(_ s: State, _ start: usize, _ goal: usize) -> i64 {
    var queue: [usize; 64] = [0; 64]
    var distance: [i64; 64] = [-1; 64]
    queue[0] = start
    distance[start] = 0
    var head: usize = 0
    var tail: usize = 1
    while head < tail {
        let current = queue[head]
        head += 1
        if current == goal { return distance[current] }
        for direction in 0 .. 6 {
            let next = neighbor(s, current, direction)
            if next < tile_count(s) && passable(s, next) && distance[next] < 0 {
                distance[next] = distance[current] + 1
                queue[tail] = next
                tail += 1
            }
        }
    }
    -1
}
fn check_bounds(_ s: State) {
    assert(s.orders >= 0 && s.orders <= 2)
    for side in 1 .. 3 {
        assert(s.gold[side] >= 0 && s.gold[side] <= 40)
        assert(s.food[side] >= 0 && s.food[side] <= 40)
    }
    for i in 0 .. tile_count(s) {
        assert(s.owner[i] >= 0 && s.owner[i] <= 2)
        assert(s.fort[i] >= 0 && s.fort[i] <= 2)
        assert(s.settlement[i] >= 0 && s.settlement[i] <= 2)
        if passable(s, i) { assert(s.troops[i] >= 1 && s.troops[i] <= 12) }
        else { assert(s.owner[i] == 0 && s.troops[i] == 0 && s.settlement[i] == 0) }
    }
}
#[test]
fn three_symmetric_hex_maps() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        let width = map_width(s)
        let last = tile_count(s) - 1
        assert(width == 5 + scenario * 2)
        assert(tile_count(s) <= 64)
        assert(s.gold[1] == s.gold[2] && s.food[1] == s.food[2])
        for a in 0 .. tile_count(s) {
            assert(terrain(s, a) == terrain(s, last - a))
            assert(s.troops[a] == s.troops[last - a])
            assert(s.settlement[a] == s.settlement[last - a])
            var degree: usize = 0
            for b in 0 .. tile_count(s) {
                assert(adjacent(s, a, b) == adjacent(s, b, a))
                assert(adjacent(s, a, b) == adjacent(s, last - a, last - b))
                if adjacent(s, a, b) { degree += 1 }
            }
            assert(degree <= 6)
        }
        assert(!adjacent(s, width - 1, width))
        assert(adjacent(s, 1, width))
        check_bounds(s)
    }
}
#[test]
fn route_evaluation_respects_all_chokepoints() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        for a in 0 .. tile_count(s) {
            if passable(s, a) {
                for b in 0 .. tile_count(s) {
                    if passable(s, b) {
                        assert(travel_distance(s, a, b) == shortest_route(s, a, b))
                    }
                }
            }
        }
    }
}
#[test]
fn mountains_are_not_legal_targets() {
    var s = initial(0)
    s.troops[1] = 6
    assert(terrain(s, 2) == 5 && !passable(s, 2))
    assert(!is_legal(s, Action { kind: 1, from: 1, to: 2, amount: 5 }))
    let choices = legal(s)
    for i in 0 .. choices.len {
        if choices.items[i].kind == 1 { assert(passable(s, choices.items[i].to)) }
    }
}
#[test]
fn starting_economy_is_generous_and_equal() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        let blue = economy(s, 1)
        let red = economy(s, 2)
        assert(blue.gold_income == 3 && red.gold_income == 3)
        assert(blue.food_production == 5 && red.food_production == 5)
        assert(blue.food_upkeep == 3 && red.food_upkeep == 3)
        assert(blue.shortage == 0 && red.shortage == 0)
        assert(blue.disconnected == 0 && red.disconnected == 0)
    }
}
#[test]
fn recruitment_costs_and_two_order_handoff() {
    var s = initial(0)
    let recruit = Action { kind: 2, from: 0, to: 0, amount: 2 }
    assert(is_legal(s, recruit))
    s = apply(s, recruit)
    assert(s.troops[0] == 8 && s.gold[1] == 5 && s.food[1] == 10)
    assert(s.orders == 1 && s.side == 1)
    s = apply(s, recruit)
    assert(s.troops[0] == 10 && s.gold[1] == 2 && s.food[1] == 8)
    assert(s.side == 2 && s.orders == 2 && s.gold[2] == 11 && s.food[2] == 14)
    assert(!is_legal(s, recruit))
}
#[test]
fn recruit_requires_supplied_settlement_and_food() {
    var s = initial(0)
    assert(!is_legal(s, Action { kind: 2, from: 1, to: 1, amount: 2 }))
    assert(is_legal(s, Action { kind: 2, from: 5, to: 5, amount: 2 }))
    s.food[1] = 1
    assert(!is_legal(s, Action { kind: 2, from: 5, to: 5, amount: 2 }))
    s.food[1] = 12
    s.owner[0] = 2
    assert(!is_legal(s, Action { kind: 2, from: 5, to: 5, amount: 2 }))
}
#[test]
fn villages_and_towns_are_real_orders() {
    var s = initial(0)
    let village = Action { kind: 4, from: 1, to: 1, amount: 1 }
    assert(is_legal(s, village))
    s = apply(s, village)
    assert(s.settlement[1] == 1 && s.gold[1] == 2 && s.orders == 1)
    assert(economy(s, 1).gold_income == 4)
    let town = Action { kind: 4, from: 1, to: 1, amount: 2 }
    assert(!is_legal(s, town))
    s.gold[1] = 8
    s = apply(s, town)
    assert(s.settlement[1] == 2 && s.gold[1] == 0)
    assert(economy(s, 1).gold_income == 5)
    s.side = 1
    s.gold[1] = 40
    assert(!is_legal(s, Action { kind: 4, from: 1, to: 1, amount: 3 }))
    assert(!is_legal(s, Action { kind: 4, from: 0, to: 0, amount: 1 }))
}
#[test]
fn pass_capture_and_defense_forecast_rules() {
    var s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 3
    assert(defense(s, 7) == 2)
    s = apply(s, Action { kind: 1, from: 6, to: 7, amount: 2 })
    assert(s.owner[7] == 0 && s.troops[7] == 1)
    s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 4
    s = apply(s, Action { kind: 1, from: 6, to: 7, amount: 3 })
    assert(s.owner[7] == 1 && s.troops[7] == 1)
}
#[test]
fn supply_cut_stops_income_and_causes_attrition() {
    var s = initial(0)
    s.owner[6] = 1
    s.owner[7] = 1
    s.owner[8] = 1
    s.troops[8] = 5
    assert(supply(s, 1)[8])
    let before = economy(s, 1)
    s.owner[7] = 2
    assert(!supply(s, 1)[8])
    let cut = economy(s, 1)
    assert(cut.disconnected == 1 && cut.gold_income == before.gold_income - 1)
    s = begin_turn(s)
    assert(s.troops[8] == 4)
    assert(!is_legal(s, Action { kind: 2, from: 8, to: 8, amount: 2 }))
}
#[test]
fn food_shortage_forecast_equals_actual_losses() {
    var s = initial(0)
    for i in 0 .. tile_count(s) {
        if passable(s, i) && i != capital(s, 2) {
            s.owner[i] = 1
            s.troops[i] = 12
        }
    }
    s.food[1] = 0
    let budget = economy(s, 1)
    assert(budget.shortage > 0 && budget.disconnected == 0)
    let count = total_army(s, 1)
    s = begin_turn(s)
    assert(s.food[1] == 0)
    assert(count - total_army(s, 1) == budget.shortage)
    check_bounds(s)
}
#[test]
fn resource_caps_and_lone_garrisons() {
    var s = initial(0)
    s.gold[1] = 40
    s.food[1] = 40
    for i in 0 .. tile_count(s) {
        if s.owner[i] == 1 { s.troops[i] = 1 }
    }
    assert(economy(s, 1).food_upkeep == 0)
    s = begin_turn(s)
    assert(s.gold[1] == 40 && s.food[1] == 40)
}
#[test]
fn capital_victory_and_stalemate() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        let home = capital(s, 2)
        s.owner[home - 1] = 1
        s.troops[home - 1] = 10
        s = apply(s, Action { kind: 1, from: home - 1, to: home, amount: 9 })
        assert(s.result == 1 && s.troops[home] == 2 && legal(s).len == 0)
        s = initial(scenario)
        for _i in 0 .. 4 { s = apply(s, pass()) }
        assert(s.result == 3)
        s = initial(scenario)
        s.turn = 120
        s = apply(s, pass())
        assert(s.result == 3)
    }
}
#[test]
fn all_generated_orders_preserve_bounds() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        var seed: usize = 17
        for step in 0 .. 240 {
            if s.result != 0 { break }
            let choices = legal(s)
            assert(choices.len > 0 && choices.len < MAX_ACTIONS)
            if step < 20 {
                for i in 0 .. choices.len { check_bounds(apply(s, choices.items[i])) }
            }
            seed = (seed * 251 + 13849) % 65521
            s = apply(s, choices.items[seed % choices.len])
            check_bounds(s)
        }
        assert(s.result != 0)
    }
}
#[test]
fn both_difficulties_take_capital_wins() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        let home = capital(s, 2)
        s.owner[home - 1] = 1
        s.troops[home - 1] = 10
        for difficulty in 0 .. 2 {
            var stats = Search { nodes: 0 }
            let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
            assert(is_legal(s, action) && apply(s, action).result == 1)
            assert(stats.nodes > 0)
        }
    }
}
#[test]
fn hard_search_remains_deeper_and_deterministic() {
    var s = initial(0)
    s = apply(s, pass())
    var easy = Search { nodes: 0 }
    var hard = Search { nodes: 0 }
    var repeat = Search { nodes: 0 }
    let a = with (Search = easy) { choose(s, 0) }
    let b = with (Search = hard) { choose(s, 1) }
    let c = with (Search = repeat) { choose(s, 1) }
    assert(is_legal(s, a) && is_legal(s, b) && same_action(b, c))
    assert(hard.nodes > easy.nodes && hard.nodes == repeat.nodes)
}

#[test]
fn capped_food_projection_uses_the_real_turn_transition() {
    var s = initial(0)
    s.food[1] = 40
    let budget = economy(s, 1)
    assert(budget.food_production - budget.food_upkeep == 2)
    let actual = begin_turn(s)
    assert(actual.food[1] == 37)
    assert(actual.food[2] == s.food[2])
}
