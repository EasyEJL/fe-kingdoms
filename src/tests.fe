// Tests exercise Fe rules directly. Protocol/replay tests live in the host suite.
fn total_army(_ s: State, _ side: i64) -> i64 {
    var total: i64 = 0
    for i in 0 .. tile_count(s) { if s.owner[i] == side { total += s.troops[i] } }
    total
}
fn shortest_route(_ s: State, _ start: usize, _ goal: usize) -> i64 {
    var queue: [usize; 64] = [0; 64]
    var distance: [i64; 64] = [-1; 64]
    queue[0] = start
    distance[start] = 0
    var head: usize = 0
    var tail: usize = 1
    while head < tail {
        let current = queue[head]
        head += 1
        if current == goal { return distance[current] }
        for direction in 0 .. 6 {
            let next = neighbor(s, current, direction)
            if next < tile_count(s) && passable(s, next) && distance[next] < 0 {
                distance[next] = distance[current] + 1
                queue[tail] = next
                tail += 1
            }
        }
    }
    -1
}
fn check_bounds(_ s: State) {
    assert(s.orders >= 0 && s.orders <= 2)
    for side in 1 .. 3 {
        assert(s.gold[side] >= 0 && s.gold[side] <= 40)
        assert(s.food[side] >= 0 && s.food[side] <= 40)
    }
    for i in 0 .. tile_count(s) {
        assert(s.owner[i] >= 0 && s.owner[i] <= 2)
        assert(s.fort[i] >= 0 && s.fort[i] <= 2)
        assert(s.settlement[i] >= 0 && s.settlement[i] <= 2)
        let army = army_at(s, i)
        assert(army.infantry >= 0 && army.cavalry >= 0 && army.siege >= 0)
        assert(army_size(army) == s.troops[i])
        if passable(s, i) { assert(s.troops[i] >= 1 && s.troops[i] <= 12) }
        else { assert(s.owner[i] == 0 && s.troops[i] == 0 && s.settlement[i] == 0) }
    }
}
#[test]
fn three_symmetric_hex_maps() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        let width = map_width(s)
        let last = tile_count(s) - 1
        assert(width == 5 + scenario * 2)
        assert(tile_count(s) <= 64)
        assert(s.gold[1] == s.gold[2] && s.food[1] == s.food[2])
        for a in 0 .. tile_count(s) {
            assert(terrain(s, a) == terrain(s, last - a))
            assert(s.troops[a] == s.troops[last - a])
            assert(s.settlement[a] == s.settlement[last - a])
            var degree: usize = 0
            for b in 0 .. tile_count(s) {
                assert(adjacent(s, a, b) == adjacent(s, b, a))
                assert(adjacent(s, a, b) == adjacent(s, last - a, last - b))
                if adjacent(s, a, b) { degree += 1 }
            }
            assert(degree <= 6)
        }
        assert(!adjacent(s, width - 1, width))
        assert(adjacent(s, 1, width))
        check_bounds(s)
    }
}
#[test]
fn route_evaluation_respects_all_chokepoints() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        for a in 0 .. tile_count(s) {
            if passable(s, a) {
                for b in 0 .. tile_count(s) {
                    if passable(s, b) {
                        assert(travel_distance(s, a, b) == shortest_route(s, a, b))
                    }
                }
            }
        }
    }
}
#[test]
fn rivers_and_mountains_are_not_legal_targets() {
    var s = initial(0)
    s.troops[1] = 6
    assert(terrain(s, 2) == 8 && !passable(s, 2))
    assert(terrain(s, 4) == 5 && !passable(s, 4))
    assert(!is_legal(s, Action { kind: 1, from: 1, to: 2, amount: 5 }))
    let choices = legal(s)
    for i in 0 .. choices.len {
        if choices.items[i].kind == 1 { assert(passable(s, choices.items[i].to)) }
    }
}
#[test]
fn starting_economy_is_generous_and_equal() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        let blue = economy(s, 1)
        let red = economy(s, 2)
        assert(blue.gold_income == 3 && red.gold_income == 3)
        assert(blue.food_production == 5 && red.food_production == 5)
        assert(blue.food_upkeep == 3 && red.food_upkeep == 3)
        assert(blue.shortage == 0 && red.shortage == 0)
        assert(blue.disconnected == 0 && red.disconnected == 0)
    }
}
#[test]
fn recruitment_costs_and_two_order_handoff() {
    var s = initial(0)
    let recruit = Action { kind: 2, from: 0, to: 0, amount: 2 }
    assert(is_legal(s, recruit))
    s = apply(s, recruit)
    assert(s.troops[0] == 8 && s.gold[1] == 5 && s.food[1] == 10)
    assert(s.orders == 1 && s.side == 1)
    s = apply(s, recruit)
    assert(s.troops[0] == 10 && s.gold[1] == 2 && s.food[1] == 8)
    assert(s.side == 2 && s.orders == 2 && s.gold[2] == 11 && s.food[2] == 14)
    assert(!is_legal(s, recruit))
}
#[test]
fn recruit_requires_supplied_settlement_and_food() {
    var s = initial(0)
    assert(!is_legal(s, Action { kind: 2, from: 1, to: 1, amount: 2 }))
    assert(is_legal(s, Action { kind: 2, from: 5, to: 5, amount: 2 }))
    s.food[1] = 1
    assert(!is_legal(s, Action { kind: 2, from: 5, to: 5, amount: 2 }))
    s.food[1] = 12
    s.owner[0] = 2
    assert(!is_legal(s, Action { kind: 2, from: 5, to: 5, amount: 2 }))
}
#[test]
fn villages_and_towns_are_real_orders() {
    var s = initial(0)
    let village = Action { kind: 4, from: 1, to: 1, amount: 1 }
    assert(is_legal(s, village))
    s = apply(s, village)
    assert(s.settlement[1] == 1 && s.gold[1] == 2 && s.orders == 1)
    assert(economy(s, 1).gold_income == 4)
    let town = Action { kind: 4, from: 1, to: 1, amount: 2 }
    assert(!is_legal(s, town))
    s.gold[1] = 8
    s = apply(s, town)
    assert(s.settlement[1] == 2 && s.gold[1] == 0)
    assert(economy(s, 1).gold_income == 5)
    s.side = 1
    s.gold[1] = 40
    assert(!is_legal(s, Action { kind: 4, from: 1, to: 1, amount: 3 }))
    assert(!is_legal(s, Action { kind: 4, from: 0, to: 0, amount: 1 }))
}
#[test]
fn pass_capture_and_defense_forecast_rules() {
    var s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 3
    assert(defense(s, 7) == 2)
    s = apply(s, Action { kind: 1, from: 6, to: 7, amount: 2 })
    assert(s.owner[7] == 0 && s.troops[7] == 1)
    s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 4
    s = apply(s, Action { kind: 1, from: 6, to: 7, amount: 3 })
    assert(s.owner[7] == 1 && s.troops[7] == 1)
}
#[test]
fn supply_cut_stops_income_and_causes_attrition() {
    var s = initial(0)
    s.owner[6] = 1
    s.owner[7] = 1
    s.owner[8] = 1
    s.troops[8] = 5
    assert(supply(s, 1)[8])
    let before = economy(s, 1)
    s.owner[7] = 2
    assert(!supply(s, 1)[8])
    let cut = economy(s, 1)
    assert(cut.disconnected == 1 && cut.gold_income == before.gold_income - 1)
    s = begin_turn(s)
    assert(s.troops[8] == 4)
    assert(!is_legal(s, Action { kind: 2, from: 8, to: 8, amount: 2 }))
}
#[test]
fn food_shortage_forecast_equals_actual_losses() {
    var s = initial(0)
    for i in 0 .. tile_count(s) {
        if passable(s, i) && i != capital(s, 2) {
            s.owner[i] = 1
            s.troops[i] = 12
        }
    }
    s.food[1] = 0
    let budget = economy(s, 1)
    assert(budget.shortage > 0 && budget.disconnected == 0)
    let count = total_army(s, 1)
    s = begin_turn(s)
    assert(s.food[1] == 0)
    assert(count - total_army(s, 1) == budget.shortage)
    check_bounds(s)
}
#[test]
fn resource_caps_and_lone_garrisons() {
    var s = initial(0)
    s.gold[1] = 40
    s.food[1] = 40
    for i in 0 .. tile_count(s) {
        if s.owner[i] == 1 { s.troops[i] = 1 }
    }
    assert(economy(s, 1).food_upkeep == 0)
    s = begin_turn(s)
    assert(s.gold[1] == 40 && s.food[1] == 40)
}
#[test]
fn capital_victory_and_stalemate() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        let home = capital(s, 2)
        s.owner[home - 1] = 1
        s.troops[home - 1] = 10
        s = apply(s, Action { kind: 1, from: home - 1, to: home, amount: 9 })
        assert(s.result == 1 && s.troops[home] == 2 && legal(s).len == 0)
        assert(supply_count(s, 2).connected == 0 && supply_count(s, 2).cut_off > 0)
        s = initial(scenario)
        for _i in 0 .. 4 { s = apply(s, pass()) }
        assert(s.result == 3)
    }
}
#[test]
fn all_generated_orders_preserve_bounds() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        var seed: usize = 17
        for step in 0 .. 2048 {
            if s.result != 0 { break }
            if s.decision_pending { s = apply(s, extend_campaign()) }
            let choices = legal(s)
            assert(choices.len > 0 && choices.len < MAX_ACTIONS)
            if step < 20 {
                for i in 0 .. choices.len { check_bounds(apply(s, choices.items[i])) }
            }
            seed = (seed * 251 + 13849) % 65521
            s = apply(s, choices.items[seed % choices.len])
            check_bounds(s)
        }
        // A bounded test budget is not a game-ending rule.
        check_bounds(s)
    }
}
#[test]
fn both_difficulties_take_capital_wins() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        let home = capital(s, 2)
        s.owner[home - 1] = 1
        s.troops[home - 1] = 10
        for difficulty in 0 .. 2 {
            var stats = Search { nodes: 0 }
            let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
            assert(is_legal(s, action) && apply(s, action).result == 1)
            assert(stats.nodes > 0)
        }
    }
}
#[test]
fn hard_search_remains_deeper_and_deterministic() {
    var s = initial(0)
    s = apply(s, pass())
    var easy = Search { nodes: 0 }
    var hard = Search { nodes: 0 }
    var repeat = Search { nodes: 0 }
    let a = with (Search = easy) { choose(s, 0) }
    let b = with (Search = hard) { choose(s, 1) }
    let c = with (Search = repeat) { choose(s, 1) }
    assert(is_legal(s, a) && is_legal(s, b) && same_action(b, c))
    assert(hard.nodes > easy.nodes && hard.nodes == repeat.nodes)
}

#[test]
fn capped_food_projection_uses_the_real_turn_transition() {
    var s = initial(0)
    s.food[1] = 40
    let budget = economy(s, 1)
    assert(budget.food_production - budget.food_upkeep == 2)
    let actual = begin_turn(s)
    assert(actual.food[1] == 37)
    assert(actual.food[2] == s.food[2])
}

// TROOP ROLE INVARIANTS AND TACTICS
fn same_army(_ a: Army, _ b: Army) -> bool {
    a.infantry == b.infantry && a.cavalry == b.cavalry && a.siege == b.siege
}
#[test]
fn every_bounded_composition_detaches_and_merges_exactly() {
    for total in 2 .. 13 {
        for cavalry in 0 .. total + 1 {
            for siege in 0 .. total - cavalry + 1 {
                let army = Army {
                    infantry: (total - cavalry - siege).downcast_unchecked(),
                    cavalry: cavalry.downcast_unchecked(), siege: siege.downcast_unchecked(),
                }
                for amount in 1 .. total {
                    let moving = detachment(army, amount.downcast_unchecked())
                    let left = subtract_armies(army, moving)
                    assert(army_size(moving) == amount.downcast_unchecked())
                    assert(army_size(left) >= 1)
                    assert(left.infantry >= 0 && left.cavalry >= 0 && left.siege >= 0)
                    assert(moving.infantry >= 0 && moving.cavalry >= 0 && moving.siege >= 0)
                    assert(same_army(combine_armies(left, moving), army))
                    if army.infantry > 0 { assert(left.infantry >= 1) }
                    else if army.cavalry > 0 { assert(left.cavalry >= 1) }
                    else { assert(left.siege >= 1) }
                    assert(same_army(moving, detachment(army, amount.downcast_unchecked())))
                }
            }
        }
    }
    let balanced = detachment(Army { infantry: 4, cavalry: 2, siege: 2 }, 4)
    assert(same_army(balanced, Army { infantry: 2, cavalry: 1, siege: 1 }))
}
#[test]
fn specialist_recruitment_and_training_are_explicit_paid_orders() {
    var s = initial(0)
    let cavalry = Action { kind: 5, from: 5, to: 5, amount: 1 }
    assert(!is_legal(s, cavalry))
    s.settlement[5] = 2
    assert(is_legal(s, cavalry))
    s = apply(s, cavalry)
    assert(s.troops[5] == 2 && s.cavalry[5] == 1 && army_at(s, 5).infantry == 1)
    assert(s.gold[1] == 4 && s.food[1] == 10 && s.orders == 1)
    assert(!is_legal(s, Action { kind: 6, from: 5, to: 5, amount: 1 }))
    s.gold[1] = 40
    s.troops[5] = 12
    let train = Action { kind: 8, from: 5, to: 5, amount: 1 }
    assert(!is_legal(s, cavalry) && is_legal(s, train))
    let before = army_at(s, 5)
    s = apply(s, train)
    assert(s.troops[5] == 12 && s.siege[5] == 1 && s.cavalry[5] == 1)
    assert(army_at(s, 5).infantry == before.infantry - 1)
    assert(s.gold[1] == 35 && s.food[1] == 7)
    s.side = 1
    s.troops[5] = 2
    assert(army_at(s, 5).infantry == 0)
    assert(!is_legal(s, Action { kind: 7, from: 5, to: 5, amount: 1 }))
    s.owner[0] = 2
    assert(!is_legal(s, Action { kind: 6, from: 5, to: 5, amount: 1 }))
}
#[test]
fn role_power_depends_on_target_and_infantry_combat_is_unchanged() {
    var s = initial(0)
    let mixed = Army { infantry: 2, cavalry: 2, siege: 2 }
    assert(attack_power(s, 11, mixed) == 8)
    assert(attack_power(s, 7, mixed) == 6)
    s.fort[7] = 2
    assert(attack_power(s, 7, mixed) == 10)
    assert(attack_power(s, 14, mixed) == 10)
    // The forest village is no longer open ground: siege helps, cavalry does not.
    assert(attack_power(s, 6, mixed) == 10)
    for troops in 2 .. 13 {
        let count: i64 = troops.downcast_unchecked()
        let infantry = Army { infantry: count, cavalry: 0, siege: 0 }
        for target_defense in 1 .. troops {
            let protection: i64 = target_defense.downcast_unchecked()
            assert(capture_losses(infantry, count, protection) == protection)
        }
    }
}
#[test]
fn mixed_capture_repel_merge_and_losses_preserve_roles() {
    var s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 8
    s.cavalry[6] = 2
    s.siege[6] = 2
    let moving = detachment(army_at(s, 6), 7)
    let combined = combine_armies(army_at(s, 5), moving)
    let friendly = apply(s, Action { kind: 1, from: 6, to: 5, amount: 7 })
    assert(same_army(army_at(friendly, 5), combined))
    assert(same_army(army_at(friendly, 6), Army { infantry: 1, cavalry: 0, siege: 0 }))
    s.owner[7] = 2
    s.troops[7] = 9
    s.fort[7] = 2
    s.cavalry[7] = 2
    s.siege[7] = 1
    let repelled = apply(s, Action { kind: 1, from: 6, to: 7, amount: 7 })
    assert(repelled.owner[7] == 2 && repelled.troops[6] == 1)
    assert(repelled.troops[7] == 1 && repelled.siege[7] == 1)
    s.troops[7] = 3
    let captured = apply(s, Action { kind: 1, from: 6, to: 7, amount: 7 })
    assert(captured.owner[7] == 1 && captured.fort[7] == 0)
    assert(captured.siege[7] == 2)
    check_bounds(captured)
}
#[test]
fn attrition_and_hunger_use_the_same_casualty_priority() {
    assert(same_army(lose_troops(Army { infantry: 2, cavalry: 2, siege: 2 }, 3),
        Army { infantry: 0, cavalry: 1, siege: 2 }))
    var s = initial(0)
    s.owner[8] = 1
    s.troops[8] = 3
    s.cavalry[8] = 1
    s.siege[8] = 1
    s = begin_turn(s)
    assert(same_army(army_at(s, 8), Army { infantry: 0, cavalry: 1, siege: 1 }))
    s = begin_turn(s)
    assert(same_army(army_at(s, 8), Army { infantry: 0, cavalry: 0, siege: 1 }))
    s = begin_turn(s)
    assert(same_army(army_at(s, 8), Army { infantry: 0, cavalry: 0, siege: 1 }))
}
fn fortified_frontline() -> State {
    var s = initial(0)
    for i in 0 .. tile_count(s) {
        if passable(s, i) {
            if i % map_width(s) < map_width(s) / 2 {
                s.owner[i] = 1
                s.troops[i] = 12
            }
        }
    }
    s.settlement[6] = 2
    s.owner[7] = 2
    s.owner[8] = 2
    s.troops[7] = 12
    s.fort[7] = 2
    s.orders = 1
    s.gold = [0, 40, 40]
    s.food = [0, 40, 40]
    s
}
#[test]
fn full_frontline_can_train_and_breach_the_fortified_pass() {
    for difficulty in 0 .. 2 {
        var s = fortified_frontline()
        let train = Action { kind: 8, from: 6, to: 6, amount: 1 }
        assert(defense(s, 7) == 15)
        assert(!is_legal(s, Action { kind: 6, from: 6, to: 6, amount: 1 }))
        assert(is_legal(s, train))
        var stats = Search { nodes: 0 }
        let chosen = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(chosen.kind == 8 && chosen.from == 6)
        s.orders = 2
        s = apply(s, train)
        s = apply(s, train)
        s = apply(s, pass())
        s = apply(s, train)
        // The siege assault needs both orders. End this preparation turn and
        // the opponent's quiet fixture turn rather than applying an illegal move.
        s = apply(s, pass())
        s = apply(s, pass())
        let assault = Action { kind: 1, from: 6, to: 7, amount: 11 }
        assert(is_legal(s, assault) && order_cost(s, assault) == 2)
        assert(attack_power(s, 7, detachment(army_at(s, 6), 11)) == 17)
        let attack = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(same_action(attack, assault))
        s = apply(s, assault)
        assert(s.owner[7] == 1 && s.troops[7] >= 1)
        check_bounds(s)
    }
}
#[test]
fn both_policies_take_specialist_capital_wins() {
    var s = initial(0)
    s.owner[13] = 1
    s.troops[13] = 12
    s.siege[13] = 2
    s.troops[14] = 12
    s.fort[14] = 2
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(apply(s, action).result == 1)
    }
}

// CAMPAIGN BOUNDARIES: these use legal, reversible friendly moves rather than
// consecutive passes, so long-run checks cannot accidentally test stalemate.
fn cycle_order(_ s: State) -> Action {
    let home = capital(s, s.side)
    let nearby = if s.side == 1 { home + 1 } else { home - 1 }
    if s.orders == 2 { Action { kind: 1, from: home, to: nearby, amount: 3 } }
    else { Action { kind: 1, from: nearby, to: home, amount: 3 } }
}
fn campaign_boundary(_ scenario: usize) -> State {
    var s = initial(scenario)
    for _step in 0 .. 720 {
        if s.decision_pending { break }
        let action = cycle_order(s)
        assert(is_legal(s, action))
        s = apply(s, action)
        check_bounds(s)
    }
    assert(s.decision_pending && s.result == 0)
    s
}
#[test]
fn scenario_boundaries_are_full_rounds_and_never_automatic_draws() {
    for scenario in 0 .. 3 {
        let s = campaign_boundary(scenario)
        assert(s.completed_rounds == base_round_limit(scenario))
        assert(s.round_limit == base_round_limit(scenario))
        assert(s.turn == s.round_limit * 2 && s.side == 2 && s.orders == 0)
        assert(s.passes == 0)
        let choices = legal(s)
        assert(choices.len == 2)
        assert(same_action(choices.items[0], extend_campaign()))
        assert(same_action(choices.items[1], accept_draw()))
        assert(!is_legal(s, pass()) && !is_legal(s, cycle_order(s)))
        assert(!is_legal(s, Action { kind: 9, from: 0, to: 0, amount: 1 }))
        assert(!is_legal(initial(scenario), extend_campaign()))
        assert(!is_legal(initial(scenario), accept_draw()))
        let drawn = apply(s, accept_draw())
        assert(drawn.result == 3 && !drawn.decision_pending && legal(drawn).len == 0)
        assert(drawn.completed_rounds == s.completed_rounds && drawn.turn == s.turn)
        assert(drawn.gold[1] == s.gold[1] && drawn.food[1] == s.food[1])
    }
}
#[test]
fn extension_pays_one_deferred_turn_without_spending_an_order() {
    var s = campaign_boundary(0)
    // Force uncapped resources and an isolated stack to expose double payment
    // or duplicate attrition that capped resources alone would conceal.
    s.gold[1] = 0
    s.food[1] = 10
    s.owner[8] = 1
    s.troops[8] = 5
    var expected = s
    expected.side = 1
    expected = begin_turn(expected)
    let continued = apply(s, extend_campaign())
    assert(continued.side == 1 && continued.orders == 2 && continued.turn == 121)
    assert(continued.round_limit == 80 && continued.completed_rounds == 60)
    assert(!continued.decision_pending && continued.result == 0)
    assert(continued.gold[1] == expected.gold[1] && continued.food[1] == expected.food[1])
    assert(continued.gold[2] == s.gold[2] && continued.food[2] == s.food[2])
    assert(continued.troops[8] == 4)
    assert(supply_count(continued, 1).connected == supply_count(s, 1).connected)
    assert(supply_count(continued, 1).cut_off == supply_count(s, 1).cut_off)
    assert(!is_legal(continued, extend_campaign()))
    assert(!is_legal(continued, accept_draw()))
}
#[test]
fn victory_and_four_passes_precede_round_decision() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        s.side = 2
        s.orders = 1
        s.turn = base_round_limit(scenario) * 2
        s.completed_rounds = base_round_limit(scenario) - 1
        s.passes = 3
        let drawn = apply(s, pass())
        assert(drawn.result == 3 && !drawn.decision_pending)
        assert(drawn.completed_rounds == base_round_limit(scenario))
        s.owner[1] = 2
        s.troops[1] = 10
        let attack = Action { kind: 1, from: 1, to: 0, amount: 9 }
        assert(is_legal(s, attack))
        let won = apply(s, attack)
        assert(won.result == 2 && !won.decision_pending && legal(won).len == 0)
        for difficulty in 0 .. 2 {
            var stats = Search { nodes: 0 }
            let chosen = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
            assert(apply(s, chosen).result == 2)
        }
    }
}
#[test]
fn boundary_search_is_a_leaf_not_an_ai_campaign_vote() {
    let s = campaign_boundary(0)
    var stats = Search { nodes: 0 }
    let score = with (Search = stats) { search(s, 3, 2, -200000, 200000) }
    assert(score == evaluate(s, 2) && stats.nodes == 1)
}
fn same_campaign(_ a: State, _ b: State) -> bool {
    if a.side != b.side || a.orders != b.orders || a.turn != b.turn || a.result != b.result
        || a.passes != b.passes || a.completed_rounds != b.completed_rounds
        || a.round_limit != b.round_limit || a.decision_pending != b.decision_pending { return false }
    for side in 0 .. 3 { if a.gold[side] != b.gold[side] || a.food[side] != b.food[side] { return false } }
    for i in 0 .. tile_count(a) {
        if a.owner[i] != b.owner[i] || a.troops[i] != b.troops[i]
            || a.fort[i] != b.fort[i] || a.settlement[i] != b.settlement[i]
            || !same_army(army_at(a, i), army_at(b, i)) { return false }
    }
    true
}
#[test]
fn extended_campaign_replay_and_bounds_survive_full_trace_capacity() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        var trace = [pass(); 2048]
        var extensions: i64 = 0
        for step in 0 .. TRACE_CAPACITY {
            let action = if s.decision_pending { extend_campaign() } else { cycle_order(s) }
            if action.kind == 9 { extensions += 1 }
            assert(is_legal(s, action))
            trace[step] = action
            s = apply(s, action)
            assert(s.result == 0)
            check_bounds(s)
            if step == 240 { assert(s.turn > 120) }
        }
        assert(extensions > 0 && s.completed_rounds > 180)
        assert(s.round_limit == base_round_limit(scenario) + extensions * EXTENSION_ROUNDS)
        var replay = initial(scenario)
        for step in 0 .. TRACE_CAPACITY {
            assert(is_legal(replay, trace[step]))
            replay = apply(replay, trace[step])
        }
        assert(same_campaign(s, replay))
    }
}

#[test]
fn fixed_rivers_bridges_and_cached_capital_routes_match_oracle() {
    for scenario in 0 .. 3 {
        let s = initial(scenario)
        let routes = navigation(s)
        var bridges: i64 = 0
        for i in 0 .. tile_count(s) {
            if terrain(s, i) == 9 {
                bridges += 1
                assert(passable(s, i) && defense(s, i) == s.troops[i] + s.fort[i] + 1)
                let cavalry = Army { infantry: 0, cavalry: 3, siege: 0 }
                assert(attack_power(s, i, cavalry) == 3)
            }
            if passable(s, i) {
                assert(routes.blue[i] == shortest_route(s, capital(s, 1), i))
                assert(routes.red[i] == shortest_route(s, capital(s, 2), i))
                assert(routes.blue[i] < 1000 && routes.red[i] < 1000)
            } else {
                assert(routes.blue[i] == 1000 && routes.red[i] == 1000)
                assert(s.owner[i] == 0 && s.settlement[i] == 0)
            }
        }
        assert(bridges == if scenario == 0 { 1 } else { 2 })
        // Widened river forces a detour within the same side of the old ridge.
        if scenario > 0 {
            let a = map_width(s) + map_width(s) / 2 - 1
            let b = 3 * map_width(s) + map_width(s) / 2 - 1
            assert(travel_distance(s, a, b) > hex_distance(s, a, b))
        }
        for root in 1 .. 3 {
            let side: i64 = root.downcast_unchecked()
            let cached = with (Navigation = routes) { evaluate_cached(s, side) }
            assert(cached == evaluate(s, side))
        }
    }
}
fn bridge_cut_position() -> State {
    var s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 12
    s.siege[6] = 3
    s.owner[7] = 2
    s.troops[7] = 2
    s.owner[8] = 2
    s.owner[11] = 2
    // This army cannot immediately recapture a defended bridge; otherwise
    // Hard sensibly destroys the army first rather than making a fragile cut.
    s.troops[11] = 8
    s.fort[11] = 2
    s.settlement[11] = 2
    s.orders = 2
    s.gold = [0, 0, 0]
    s.food = [0, 40, 40]
    s
}
#[test]
fn both_policies_capture_bridge_and_cut_enemy_supply() {
    let s = bridge_cut_position()
    assert(supply(s, 2)[11] && supply_count(s, 2).cut_off == 0)
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let chosen = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(chosen.kind == 1 && chosen.from == 6 && chosen.to == 7)
        let after = apply(s, chosen)
        assert(after.owner[7] == 1 && !supply(after, 2)[11])
        assert(supply_count(after, 2).cut_off == 1)
        assert(after.troops[11] == 7)
        check_bounds(after)
    }
    // With a stronger army able to retake the bridge, Hard removes that
    // counterattack threat first. A compulsory immediate cut would be worse.
    var threatened = s
    threatened.troops[11] = 12
    var hard = Search { nodes: 0 }
    let preparation = with (Search = hard) { choose(threatened, 1) }
    assert(preparation.kind == 1 && preparation.from == 6 && preparation.to == 11)
    let secured = apply(threatened, preparation)
    assert(secured.owner[11] == 1)
    assert(total_army(secured, 2) == total_army(threatened, 2) - 12)
}
#[test]
fn supply_counts_distinguish_capture_cut_and_reconnection() {
    var s = bridge_cut_position()
    let before_blue = supply_count(s, 1)
    let before_red = supply_count(s, 2)
    let after = apply(s, Action { kind: 1, from: 6, to: 7, amount: 11 })
    let blue = supply_count(after, 1)
    let red = supply_count(after, 2)
    // Blue gained a captured tile, not a reconnected tile. Red lost a tile
    // and has one retained tile disconnected by the lost crossing.
    assert(blue.connected == before_blue.connected + 1 && blue.cut_off == 0)
    assert(red.connected == before_red.connected - 2 && red.cut_off == 1)
    s = initial(0)
    s.owner[6] = 1
    s.troops[6] = 10
    s.owner[7] = 2
    s.owner[8] = 1
    s.troops[8] = 4
    s.gold[1] = 0
    assert(supply_count(s, 1).cut_off == 1)
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(action.kind == 1 && action.to == 7)
        let reconnected = apply(s, action)
        assert(supply_count(reconnected, 1).cut_off == 0)
        assert(supply_count(reconnected, 1).connected == supply_count(s, 1).connected + 2)
    }
    // Water cannot form a supply path, even in an intentionally invalid state.
    s.owner[2] = 1
    s.owner[3] = 1
    assert(!supply(s, 1)[2] && !supply(s, 1)[3])
}
#[test]
fn navigation_cache_is_scoped_to_one_decision() {
    let scenarios: [usize; 4] = [0, 2, 1, 0]
    for difficulty in 0 .. 2 {
        var first = pass()
        var first_nodes: i64 = 0
        for index in 0 .. 4 {
            let s = initial(scenarios[index])
            var stats = Search { nodes: 0 }
            let action = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
            assert(is_legal(s, action))
            if index == 0 { first = action
                first_nodes = stats.nodes }
            if index == 3 { assert(same_action(action, first) && stats.nodes == first_nodes) }
        }
    }
}

// V7 FORESTS AND DETACHMENT-SPECIFIC ORDER COSTS
#[test]
fn forests_are_symmetric_and_infantry_protection_is_small() {
    for scenario in 0 .. 3 {
        var s = initial(scenario)
        var count: i64 = 0
        for i in 0 .. tile_count(s) {
            if terrain(s, i) == 10 {
                count += 1
                assert(passable(s, i) && terrain(s, tile_count(s) - 1 - i) == 10)
                assert(defense(s, i) == s.troops[i] + s.fort[i] + 1)
                s.troops[i] = 5
                s.cavalry[i] = 5
                assert(defense(s, i) == 5 + s.fort[i])
                s.cavalry[i] = 4
                assert(defense(s, i) == 6 + s.fort[i])
                s.cavalry[i] = 0
                assert(defense(s, i) == 6 + s.fort[i])
                assert(attack_power(s, i, Army { infantry: 0, cavalry: 3, siege: 0 }) == 3)
            }
        }
        assert(count == 2)
        assert(attack_power(s, 1, Army { infantry: 0, cavalry: 3, siege: 0 }) == 6)
    }
}
#[test]
fn one_order_can_move_infantry_while_leaving_specialists_behind() {
    for role in 1 .. 3 {
        var s = initial(0)
        s.orders = 1
        s.troops[5] = 5
        if role == 1 { s.cavalry[5] = 1 } else { s.siege[5] = 1 }
        let half = Action { kind: 1, from: 5, to: 6, amount: 2 }
        let full = Action { kind: 1, from: 5, to: 6, amount: 4 }
        assert(same_army(detachment(army_at(s, 5), 2), Army { infantry: 2, cavalry: 0, siege: 0 }))
        assert(order_cost(s, half) == 1 && is_legal(s, half))
        assert(order_cost(s, full) == 2 && !is_legal(s, full))
        // The neutral forest has one infantry and one protection: a tie repels.
        let after = apply(s, half)
        assert(after.owner[6] == 0 && after.side == 2 && after.orders == 2)
        assert(after.cavalry[5] == s.cavalry[5] && after.siege[5] == s.siege[5])
        s.orders = 2
        assert(is_legal(s, full))
        let capture = apply(s, full)
        assert(capture.owner[6] == 1 && capture.side == 2 && capture.orders == 2)
        check_bounds(capture)
    }
}
#[test]
fn every_detachment_pays_max_role_cost_and_friendly_moves_conserve_roles() {
    for total in 2 .. 13 {
        for cavalry in 0 .. total + 1 {
            for siege in 0 .. total - cavalry + 1 {
                var s = initial(0)
                s.owner[6] = 1
                s.troops[5] = total.downcast_unchecked()
                s.cavalry[5] = cavalry.downcast_unchecked()
                s.siege[5] = siege.downcast_unchecked()
                let original = combine_armies(army_at(s, 5), army_at(s, 6))
                for amount in 1 .. total {
                    let moving = detachment(army_at(s, 5), amount.downcast_unchecked())
                    let expected: i64 = if moving.cavalry > 0 || moving.siege > 0 { 2 } else { 1 }
                    assert(move_order_cost(s, 6, moving) == expected)
                    assert(move_order_cost(s, 1, moving) == if moving.siege > 0 { 2 } else { 1 })
                    if amount == total - 1 || amount == total / 2 {
                        let action = Action { kind: 1, from: 5, to: 6, amount: amount.downcast_unchecked() }
                        assert(is_legal(s, action) && order_cost(s, action) == expected)
                        let after = apply(s, action)
                        assert(same_army(combine_armies(army_at(after, 5), army_at(after, 6)), original))
                        assert(after.side == if expected == 2 { 2 } else { 1 })
                        assert(after.orders == if expected == 2 { 2 } else { 1 })
                        assert(after.gold[1] == s.gold[1] && after.food[1] == s.food[1])
                        check_bounds(after)
                        s.orders = 1
                        assert(is_legal(s, action) == (expected == 1))
                        s.orders = 2
                    }
                }
            }
        }
    }
}
#[test]
fn forest_opening_replays_and_old_small_attack_is_a_tie() {
    let opening = [Action { kind: 1, from: 0, to: 1, amount: 5 },
        Action { kind: 1, from: 1, to: 6, amount: 7 }]
    var s = initial(0)
    var replay = initial(0)
    for i in 0 .. 2 {
        assert(is_legal(s, opening[i]) && order_cost(s, opening[i]) == 1)
        s = apply(s, opening[i])
        replay = apply(replay, opening[i])
        check_bounds(s)
    }
    assert(s.owner[6] == 1 && s.troops[6] == 5 && s.side == 2)
    assert(same_campaign(s, replay))
    var old = initial(0)
    old = apply(old, Action { kind: 2, from: 5, to: 5, amount: 2 })
    let attack = Action { kind: 1, from: 5, to: 6, amount: 2 }
    assert(is_legal(old, attack))
    assert(attack_power(old, 6, detachment(army_at(old, 5), 2)) == defense(old, 6))
    assert(apply(old, attack).owner[6] == 0)
}
#[test]
fn both_policies_respect_two_order_siege_and_one_order_limits() {
    var s = initial(0)
    s.owner[13] = 1
    s.troops[13] = 12
    s.siege[13] = 2
    s.troops[14] = 12
    s.fort[14] = 2
    s.orders = 1
    let assault = Action { kind: 1, from: 13, to: 14, amount: 11 }
    assert(order_cost(s, assault) == 2 && !is_legal(s, assault))
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let chosen = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(is_legal(s, chosen) && order_cost(s, chosen) <= 1)
        assert(!same_action(chosen, assault))
    }
    s.orders = 2
    for difficulty in 0 .. 2 {
        var stats = Search { nodes: 0 }
        let chosen = with (Search = stats) { choose(s, difficulty.downcast_unchecked()) }
        assert(is_legal(s, chosen) && order_cost(s, chosen) == 2)
        assert(apply(s, chosen).result == 1)
    }
    assert(order_cost(s, pass()) == 2)
    assert(order_cost(s, extend_campaign()) == 0 && order_cost(s, accept_draw()) == 0)
}
