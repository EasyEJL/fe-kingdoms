use core::marker::Copy

// Crownlines v3. The native Fe engine owns every rule and opponent decision.
// Fixed capacities bound memory; scenario metadata selects active map cells.
const MAX_TILES: usize = 64
const MAX_ACTIONS: usize = 1024
const MAX_TROOPS: i64 = 12
const RESOURCE_CAP: i64 = 40

struct State {
    owner: [i64; 64],
    troops: [i64; 64],
    fort: [i64; 64],
    settlement: [i64; 64],
    gold: [i64; 3],
    food: [i64; 3],
    scenario: usize,
    side: i64,
    orders: i64,
    turn: i64,
    result: i64,
    passes: i64,
}
impl Copy for State {}
struct Action { kind: i64, from: usize, to: usize, amount: i64 }
impl Copy for Action {}
struct Actions { items: [Action; 1024], len: usize }
impl Copy for Actions {}
struct Search { nodes: i64 }
struct Economy {
    gold_income: i64,
    food_production: i64,
    food_upkeep: i64,
    disconnected: i64,
    shortage: i64,
}
impl Copy for Economy {}

fn imin(_ a: i64, _ b: i64) -> i64 { if a < b { a } else { b } }
fn imax(_ a: i64, _ b: i64) -> i64 { if a > b { a } else { b } }
fn abs(_ n: i64) -> i64 { if n < 0 { -n } else { n } }
fn pass() -> Action { Action { kind: 0, from: 0, to: 0, amount: 0 } }
fn map_width(_ s: State) -> usize {
    if s.scenario == 0 { 5 } else if s.scenario == 1 { 7 } else { 9 }
}
fn map_height(_ s: State) -> usize { if s.scenario == 0 { 3 } else { 5 } }
fn tile_count(_ s: State) -> usize { map_width(s) * map_height(s) }
fn capital(_ s: State, _ side: i64) -> usize {
    if side == 1 { 0 } else { tile_count(s) - 1 }
}

// AXIAL GEOMETRY AND MAPS
// q = column, r = row. A central ridge must be crossed at its mountain passes.
fn hex_distance(_ s: State, _ a: usize, _ b: usize) -> i64 {
    let width = map_width(s)
    let aq: i64 = (a % width).downcast_unchecked()
    let ar: i64 = (a / width).downcast_unchecked()
    let bq: i64 = (b % width).downcast_unchecked()
    let br: i64 = (b / width).downcast_unchecked()
    (abs(aq - bq) + abs(ar - br) + abs(aq - bq + ar - br)) / 2
}
fn neighbor(_ s: State, _ tile: usize, _ direction: usize) -> usize {
    let width: i64 = map_width(s).downcast_unchecked()
    let height: i64 = map_height(s).downcast_unchecked()
    let mut_q: i64 = (tile % map_width(s)).downcast_unchecked()
    let mut_r: i64 = (tile / map_width(s)).downcast_unchecked()
    var q = mut_q
    var r = mut_r
    if direction == 0 { q += 1 }
    else if direction == 1 { q -= 1 }
    else if direction == 2 { r += 1 }
    else if direction == 3 { r -= 1 }
    else if direction == 4 { q += 1
        r -= 1 }
    else { q -= 1
        r += 1 }
    if q < 0 || q >= width || r < 0 || r >= height { return MAX_TILES }
    (r * width + q).downcast_unchecked()
}
fn adjacent(_ s: State, _ a: usize, _ b: usize) -> bool {
    a < tile_count(s) && b < tile_count(s) && hex_distance(s, a, b) == 1
}
fn is_pass_row(_ s: State, _ row: usize) -> bool {
    if s.scenario == 0 { row == 1 } else { row == 1 || row == 3 }
}
fn terrain(_ s: State, _ i: usize) -> i64 {
    let width = map_width(s)
    let height = map_height(s)
    let last = tile_count(s) - 1
    let q = i % width
    let r = i / width
    if i == 0 || i == last { return 4 }
    if q == width / 2 {
        if is_pass_row(s, r) { return 7 }
        return 5
    }
    if i == 1 || i == last - 1
        || i == (height - 1) * width + 1
        || i == width - 2 { return 1 }
    if (r == height / 2 && (q == 0 || q == width - 1))
        || (height > 3 && r == 0 && q == width / 2 - 1)
        || (height > 3 && r == height - 1 && q == width / 2 + 1) { return 3 }
    0
}
fn passable(_ s: State, _ i: usize) -> bool {
    i < tile_count(s) && terrain(s, i) != 5
}
// Exact route length for this map family: same-side paths stay in a convex
// half-map; crossing paths must use one of the explicitly walkable passes.
fn travel_distance(_ s: State, _ a: usize, _ b: usize) -> i64 {
    let width = map_width(s)
    let middle = width / 2
    let aq = a % width
    let bq = b % width
    if (aq < middle && bq < middle) || (aq > middle && bq > middle)
        || a == b { return hex_distance(s, a, b) }
    if aq == middle && bq == middle { return hex_distance(s, a, b) + 1 }
    var best: i64 = 1000
    for row in 0 .. map_height(s) {
        if is_pass_row(s, row) {
            let crossing = row * width + middle
            best = imin(best, hex_distance(s, a, crossing) + hex_distance(s, crossing, b))
        }
    }
    best
}

// INITIAL STATE AND SUPPLY
fn initial(_ scenario: usize) -> State {
    assert(scenario <= 2)
    var s = State {
        owner: [0; 64], troops: [0; 64], fort: [0; 64], settlement: [0; 64],
        gold: [0, 8, 8], food: [0, 12, 12], scenario,
        side: 1, orders: 2, turn: 1, result: 0, passes: 0,
    }
    let width = map_width(s)
    let last = tile_count(s) - 1
    for i in 0 .. tile_count(s) {
        if passable(s, i) { s.troops[i] = 1 }
    }
    s.owner[0] = 1
    s.owner[1] = 1
    s.owner[width] = 1
    s.owner[last] = 2
    s.owner[last - 1] = 2
    s.owner[last - width] = 2
    s.troops[0] = 6
    s.troops[last] = 6
    s.troops[1] = 3
    s.troops[last - 1] = 3
    s.fort[0] = 1
    s.fort[last] = 1
    s.settlement[width] = 1
    s.settlement[last - width] = 1
    let village = (map_height(s) / 2) * width + width / 2 - 1
    s.settlement[village] = 1
    s.settlement[last - village] = 1
    s
}
fn supply(_ s: State, _ side: i64) -> [bool; 64] {
    var connected = [false; 64]
    var queue: [usize; 64] = [0; 64]
    let home = capital(s, side)
    if s.owner[home] != side { return connected }
    connected[home] = true
    queue[0] = home
    var head: usize = 0
    var tail: usize = 1
    while head < tail {
        let current = queue[head]
        head += 1
        for direction in 0 .. 6 {
            let next = neighbor(s, current, direction)
            if next < tile_count(s) && !connected[next] && s.owner[next] == side
                && passable(s, next) {
                connected[next] = true
                queue[tail] = next
                tail += 1
            }
        }
    }
    connected
}
fn army_upkeep(_ troops: i64) -> i64 { (troops - 1 + 2) / 3 }
fn economy_with_supply(_ s: State, _ side: i64, _ connected: [bool; 64]) -> Economy {
    var result = Economy {
        gold_income: 2, food_production: 3, food_upkeep: 0,
        disconnected: 0, shortage: 0,
    }
    for i in 0 .. tile_count(s) {
        if s.owner[i] == side {
            if connected[i] {
                result.gold_income += s.settlement[i]
                if terrain(s, i) == 1 { result.food_production += 2 }
                result.food_upkeep += army_upkeep(s.troops[i])
            } else { result.disconnected += 1 }
        }
    }
    let player: usize = side.downcast_unchecked()
    let available = imin(RESOURCE_CAP, s.food[player] + result.food_production)
    result.shortage = imax(0, result.food_upkeep - available)
    result
}
fn economy(_ s: State, _ side: i64) -> Economy {
    economy_with_supply(s, side, supply(s, side))
}
// This same routine supplies forecasts and actual turn-start consequences.
fn begin_turn(_ before: State) -> State {
    var s = before
    let connected = supply(s, s.side)
    let budget = economy_with_supply(s, s.side, connected)
    let player: usize = s.side.downcast_unchecked()
    s.gold[player] = imin(RESOURCE_CAP, s.gold[player] + budget.gold_income)
    s.food[player] = imax(0, imin(RESOURCE_CAP, s.food[player] + budget.food_production) - budget.food_upkeep)
    for i in 0 .. tile_count(s) {
        if s.owner[i] == s.side && !connected[i] { s.troops[i] = imax(1, s.troops[i] - 1) }
    }
    // Each missing ration removes one mobile troop, strongest armies first.
    // Tie order is mirrored for the two kingdoms to preserve map symmetry.
    var remaining = budget.shortage
    while remaining > 0 {
        var chosen: usize = MAX_TILES
        var strongest: i64 = 1
        for index in 0 .. tile_count(s) {
            let i = if s.side == 1 { index } else { tile_count(s) - 1 - index }
            if s.owner[i] == s.side && connected[i] && s.troops[i] > strongest {
                strongest = s.troops[i]
                chosen = i
            }
        }
        if chosen == MAX_TILES { break }
        s.troops[chosen] -= 1
        remaining -= 1
    }
    s
}

// LEGAL ORDERS
fn empty_actions() -> Actions { Actions { items: [pass(); 1024], len: 0 } }
fn add(_ action: Action) uses (list: mut Actions) {
    assert(list.len < MAX_ACTIONS)
    list.items[list.len] = action
    list.len += 1
}
fn settlement_cost(_ level: i64) -> i64 { if level == 1 { 6 } else { 8 } }
fn legal(_ s: State) -> Actions {
    var result = empty_actions()
    if s.result != 0 { return result }
    let connected = supply(s, s.side)
    let player: usize = s.side.downcast_unchecked()
    with (Actions = result) {
        add(pass())
        for i in 0 .. tile_count(s) {
            if s.owner[i] == s.side && passable(s, i) {
                if connected[i] {
                    if s.gold[player] >= 3 && s.food[player] >= 2 && s.troops[i] <= 10
                        && (terrain(s, i) == 4 || s.settlement[i] > 0) {
                        add(Action { kind: 2, from: i, to: i, amount: 2 })
                    }
                    if s.gold[player] >= 2 && s.fort[i] < 2 {
                        add(Action { kind: 3, from: i, to: i, amount: 1 })
                    }
                    if terrain(s, i) != 4 && s.settlement[i] < 2
                        && s.gold[player] >= settlement_cost(s.settlement[i] + 1) {
                        add(Action { kind: 4, from: i, to: i, amount: s.settlement[i] + 1 })
                    }
                }
                if s.troops[i] > 1 {
                    for direction in 0 .. 6 {
                        let target = neighbor(s, i, direction)
                        if target < tile_count(s) && passable(s, target) {
                            let full = s.troops[i] - 1
                            let half = s.troops[i] / 2
                            if s.owner[target] != s.side || s.troops[target] + full <= MAX_TROOPS {
                                add(Action { kind: 1, from: i, to: target, amount: full })
                            }
                            if half != full && (s.owner[target] != s.side || s.troops[target] + half <= MAX_TROOPS) {
                                add(Action { kind: 1, from: i, to: target, amount: half })
                            }
                        }
                    }
                }
            }
        }
    }
    result
}
fn same_action(_ a: Action, _ b: Action) -> bool {
    a.kind == b.kind && a.from == b.from && a.to == b.to && a.amount == b.amount
}
fn is_legal(_ s: State, _ action: Action) -> bool {
    let choices = legal(s)
    for i in 0 .. choices.len { if same_action(action, choices.items[i]) { return true } }
    false
}
fn defense(_ s: State, _ tile: usize) -> i64 {
    let ground = terrain(s, tile)
    s.troops[tile] + s.fort[tile] + if ground == 3 || ground == 7 { 1 } else { 0 }
}

// AUTHORITATIVE TRANSITION
// Call only after validating, or with an action returned by legal().
fn apply(_ before: State, _ action: Action) -> State {
    var s = before
    let player: usize = s.side.downcast_unchecked()
    if action.kind == 0 {
        s.passes += 1
        s.orders = 0
    } else {
        s.passes = 0
        s.orders -= 1
        if action.kind == 2 {
            s.gold[player] -= 3
            s.food[player] -= 2
            s.troops[action.from] += 2
        } else if action.kind == 3 {
            s.gold[player] -= 2
            s.fort[action.from] += 1
        } else if action.kind == 4 {
            s.gold[player] -= settlement_cost(action.amount)
            s.settlement[action.from] = action.amount
        } else {
            s.troops[action.from] -= action.amount
            if s.owner[action.to] == s.side {
                s.troops[action.to] += action.amount
            } else {
                let strength = defense(s, action.to)
                if action.amount > strength {
                    s.owner[action.to] = s.side
                    s.troops[action.to] = action.amount - strength
                    s.fort[action.to] = 0
                } else {
                    let protection = strength - s.troops[action.to]
                    let casualties = imax(1, action.amount - protection)
                    s.troops[action.to] = imax(1, s.troops[action.to] - casualties)
                }
            }
        }
    }
    if s.owner[capital(s, 1)] == 2 { s.result = 2 }
    if s.owner[capital(s, 2)] == 1 { s.result = 1 }
    if s.result != 0 { return s }
    if s.orders == 0 {
        s.side = 3 - s.side
        s.orders = 2
        s.turn += 1
        if s.turn > 120 || s.passes >= 4 { s.result = 3
            return s }
        return begin_turn(s)
    }
    s
}

// OPPONENT EVALUATION AND BOUNDED SEARCH
fn evaluate(_ s: State, _ root: i64) -> i64 {
    if s.result == root { return 100000 - s.turn }
    if s.result == 3 - root { return -100000 + s.turn }
    if s.result == 3 { return 0 }
    let player: usize = root.downcast_unchecked()
    let opponent: usize = (3 - root).downcast_unchecked()
    var score = (s.gold[player] - s.gold[opponent]) * 2
        + (s.food[player] - s.food[opponent]) * 2
    let own_supply = supply(s, root)
    let enemy_supply = supply(s, 3 - root)
    let span = travel_distance(s, 0, tile_count(s) - 1)
    for i in 0 .. tile_count(s) {
        if s.owner[i] != 0 {
            let sign: i64 = if s.owner[i] == root { 1 } else { -1 }
            let connected = if sign == 1 { own_supply[i] } else { enemy_supply[i] }
            let enemy_capital = capital(s, 3 - s.owner[i])
            let distance = travel_distance(s, i, enemy_capital)
            score += sign * (24 + s.troops[i] * 12 + s.fort[i] * 4)
            if connected {
                score += sign * (10 + s.settlement[i] * 18)
                if terrain(s, i) == 1 { score += sign * 26 }
            } else { score -= sign * (16 + s.troops[i] * 2) }
            if terrain(s, i) == 7 { score += sign * 18 }
            if s.troops[i] > 1 { score += sign * ((span - distance) * s.troops[i]) }
            if adjacent(s, i, enemy_capital) {
                score += sign * s.troops[i] * 5
                if s.troops[i] - 1 > defense(s, enemy_capital) { score += sign * 300 }
            }
        }
    }
    let own_budget = economy_with_supply(s, root, own_supply)
    let enemy_budget = economy_with_supply(s, 3 - root, enemy_supply)
    score += (own_budget.food_production - own_budget.food_upkeep) * 5 -
        (enemy_budget.food_production - enemy_budget.food_upkeep) * 5
    score -= own_budget.shortage * 25
    score += enemy_budget.shortage * 25
    score
}
fn ranked(_ s: State, _ root: i64) -> Actions {
    var list = legal(s)
    var scores = [0; 1024]
    for i in 0 .. list.len { scores[i] = evaluate(apply(s, list.items[i]), root) }
    for i in 1 .. list.len {
        let chosen = list.items[i]
        let value = scores[i]
        var j = i
        while j > 0 {
            let previous = scores[j - 1]
            let better = if s.side == root { value > previous } else { value < previous }
            if !better { break }
            list.items[j] = list.items[j - 1]
            scores[j] = scores[j - 1]
            j -= 1
        }
        list.items[j] = chosen
        scores[j] = value
    }
    list
}
fn search(_ s: State, _ depth: usize, _ root: i64, _ low: i64, _ high: i64) -> i64 uses (stats: mut Search) {
    stats.nodes += 1
    if depth == 0 || s.result != 0 { return evaluate(s, root) }
    let list = ranked(s, root)
    let bound = if list.len < 6 { list.len } else { 6 }
    var alpha = low
    var beta = high
    var best: i64 = if s.side == root { -200000 } else { 200000 }
    for i in 0 .. bound {
        let value = search(apply(s, list.items[i]), depth - 1, root, alpha, beta)
        if s.side == root { best = imax(best, value)
            alpha = imax(alpha, best) }
        else { best = imin(best, value)
            beta = imin(beta, best) }
        if alpha >= beta { break }
    }
    best
}
fn choose(_ s: State, _ difficulty: i64) -> Action uses (stats: mut Search) {
    let list = ranked(s, s.side)
    if difficulty == 0 { stats.nodes += list.len.downcast_unchecked()
        return list.items[0] }
    let bound = if list.len < 10 { list.len } else { 10 }
    var best = list.items[0]
    var score: i64 = -200000
    for i in 0 .. bound {
        let value = search(apply(s, list.items[i]), 3, s.side, -200000, 200000)
        if value > score { score = value
            best = list.items[i] }
    }
    best
}
